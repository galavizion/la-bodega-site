---
import { Image } from "astro:assets";
import PortableTextRenderer from "../PortableTextRenderer.astro";
import { urlFor } from "../../lib/sanity/image";

const {
  title,
  layout = "default",
  image,
  youtubeUrl,
  imageSide = "right",
  bgColor,
  textAlign = "left",
  content = [],
  cta,
  settings = {},
  sectionId
} = Astro.props;

const resolvedId = sectionId || settings?.sectionId;
const bg = bgColor && bgColor !== "none" ? bgColor : null;
const bgNorm = bg?.toLowerCase().replace(/\s/g, "");
const isDark  = bgNorm === "#000000" || bgNorm === "#000";
const isLight = bgNorm === "#ffffff" || bgNorm === "#fff" || bgNorm === "#ffd700" || bgNorm === "white";
const bgTheme = isDark ? "section--on-dark" : isLight ? "section--on-light" : "";
const imgUrl = image ? urlFor(image).width(1200).quality(80).auto("format").url() : null;

// Extrae el embed URL de YouTube desde URL o código iframe
function getYoutubeEmbed(input: string | undefined): string | null {
  if (!input) return null;
  // Si es un iframe, extrae el src
  const srcMatch = input.match(/src=["']([^"']+)["']/);
  const raw = srcMatch ? srcMatch[1] : input;
  // Ya es embed URL
  if (raw.includes("youtube.com/embed/")) return raw;
  // youtube.com/watch?v=ID
  const watchMatch = raw.match(/[?&]v=([^&\s]+)/);
  if (watchMatch) return `https://www.youtube.com/embed/${watchMatch[1]}`;
  // youtu.be/ID
  const shortMatch = raw.match(/youtu\.be\/([^?&\s]+)/);
  if (shortMatch) return `https://www.youtube.com/embed/${shortMatch[1]}`;
  return null;
}

const videoEmbedUrl = getYoutubeEmbed(youtubeUrl);
const hasSplit = !!(videoEmbedUrl || imgUrl);
---

<section id={resolvedId} class={`section content-split content-split--${layout} ${bgTheme}`} style={bg ? `background-color:${bg}` : undefined}>
  <div class="container">
    {!hasSplit ? (
      <div class="content-split__single" style={`text-align:${textAlign}`}>
        {title && <h2>{title}</h2>}
        <div class="content-split__text">
          <PortableTextRenderer value={content} />
        </div>
        {cta?.label && cta?.url && (
          <div class="content-split__cta">
            <a class="btn btn--primary" href={cta.url}>{cta.label}</a>
          </div>
        )}
      </div>
    ) : (
      <div class="content-split__grid">
        {imageSide === "left" && (
          <div class="content-split__media">
            {videoEmbedUrl ? (
              <div class="content-split__video">
                <iframe src={videoEmbedUrl} title={title || "Video"} frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin" allowfullscreen loading="lazy"></iframe>
              </div>
            ) : imgUrl ? (
              <img src={imgUrl} alt={title || ""} width={1200} loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
            ) : null}
          </div>
        )}

        <div class="content-split__content" style={`text-align:${textAlign}`}>
          {title && <h2>{title}</h2>}
          <div class="content-split__text">
            <PortableTextRenderer value={content} />
          </div>
          {cta?.label && cta?.url && (
            <div class="content-split__cta">
              <a class="btn btn--primary" href={cta.url}>{cta.label}</a>
            </div>
          )}
        </div>

        {imageSide === "right" && (
          <div class="content-split__media">
            {videoEmbedUrl ? (
              <div class="content-split__video">
                <iframe src={videoEmbedUrl} title={title || "Video"} frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin" allowfullscreen loading="lazy"></iframe>
              </div>
            ) : imgUrl ? (
              <img src={imgUrl} alt={title || ""} width={1200} loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
            ) : null}
          </div>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .content-split{
    padding: 70px 0;
  }

  .content-split__single{
    max-width: 860px;
    margin: 0 auto;
  }

  .content-split__grid{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .content-split__content h2,
  .content-split__single h2{
    margin: 0 0 16px;
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.08;
  }

  .content-split__text{
    line-height: 1.65;
  }
  .content-split__cta { margin-top: 24px; }

  .content-split__media img{
    width: 100%;
    height: auto;
    display: block;
    border-radius: 18px;
    box-shadow: 0 10px 30px rgba(0,0,0,.08);
  }

  /* Video responsive 16:9 */
  .content-split__video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,.15);
  }
  .content-split__video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .section--on-dark .content-split__content h2,
  .section--on-dark .content-split__single h2{
    color: #fff;
  }
  .section--on-dark .content-split__text{ color: rgba(255,255,255,.88); }

  .section--on-light { color: #111; }
  .section--on-light .content-split__content h2,
  .section--on-light .content-split__single h2{
    color: #000;
  }
  .section--on-light .content-split__text{ color: rgba(0,0,0,.85); }

  @media (max-width: 900px){
    .content-split__grid{
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>