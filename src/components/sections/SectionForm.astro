---
import { client as sanityClient } from "../../lib/sanity/client";
import groq from "groq";

const globalPhone: string = await sanityClient.fetch(
  groq`coalesce(*[_type=="siteSettingsGeneral"][0].organization.whatsapp, *[_type=="siteSettings"][0].organization.whatsapp, "")`
);

type FormField = {
  _key?: string;
  type?: "text" | "email" | "tel" | "textarea" | "select";
  label?: string;
  placeholder?: string;
  required?: boolean;
  options?: string;
};

type Props = {
  title?: string;
  subtitle?: string;
  bgColor?: string;
  textAlign?: "left" | "center" | "right";
  cta?: { label?: string; url?: string } | null;
  formType?: "contact" | "quote" | "newsletter";
  fields?: FormField[] | null;
  submitLabel?: string;
  successMessage?: string;
  whatsappFallback?: { enabled?: boolean; phone?: string; label?: string } | null;
  settings?: { sectionId?: string };
};

const {
  title,
  subtitle,
  bgColor,
  textAlign = "left",
  cta,
  formType = "contact",
  fields,
  submitLabel = "Enviar mensaje",
  successMessage = "¡Mensaje recibido! Te contactamos pronto.",
  whatsappFallback,
  settings,
} = Astro.props as Props;

const sectionId = settings?.sectionId;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";

const bg = bgColor && bgColor !== "none" ? bgColor : null;
const bgTheme = bg === "#000000" ? "section--on-dark"
  : (bg === "#ffffff" || bg?.toLowerCase() === "#FFD700") ? "section--on-light"
  : "";

const safeFields: FormField[] = Array.isArray(fields) && fields.length
  ? fields
  : [
      { type: "text",     label: "Nombre",   placeholder: "Tu nombre",                  required: true  },
      { type: "email",    label: "Correo",   placeholder: "correo@empresa.com",         required: true  },
      { type: "tel",      label: "Teléfono", placeholder: "55 1234 5678",               required: false },
      { type: "textarea", label: "Mensaje",  placeholder: "¿En qué te podemos ayudar?", required: true  },
    ];

const formId = `form-${Math.random().toString(36).slice(2, 7)}`;
const waPhone  = (whatsappFallback?.phone || globalPhone).replace(/\D/g, "");
const waLabel  = whatsappFallback?.label  ?? "O escríbenos por WhatsApp";
const waActive = waPhone;
---

<section id={sectionId} class={`section form-section ${bgTheme}`} style={`${bg ? `background-color:${bg};` : ''}--section-bg:${bg ?? '#000000'}`}>
  <div class="container">
    <div class="form-grid">

      <!-- Columna izquierda: copy -->
      <div class="form-copy" style={`text-align:${textAlign}`}>
        {title    && <h2 class="form-copy__title">{title}</h2>}
        {subtitle && <p  class="form-copy__sub">{subtitle}</p>}

        {cta?.label && cta?.url && (
          <a class="btn btn--primary" href={cta.url} style="display:inline-flex;margin-bottom:16px">{cta.label}</a>
        )}

        {waActive && (
          <a
            class="wa-btn"
            href={`https://wa.me/${waPhone}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {waLabel}
          </a>
        )}
      </div>

      <!-- Columna derecha: formulario -->
      <form
        id={formId}
        class="form-card"
        data-form-type={formType}
        data-success={successMessage}
        novalidate
      >
        {safeFields.map((f, i) => {
          const fieldId = `${formId}-${i}`;
          const name = (f.label ?? `campo${i}`).toLowerCase().replace(/\s+/g, "_");
          const opts = f.type === "select" && f.options
            ? f.options.split("\n").map((o) => o.trim()).filter(Boolean)
            : [];

          return (
            <div class="field">
              {f.label && <label for={fieldId}>{f.label}{f.required ? " *" : ""}</label>}

              {f.type === "textarea" ? (
                <textarea
                  id={fieldId}
                  name={name}
                  placeholder={f.placeholder ?? ""}
                  required={f.required}
                  rows={4}
                />
              ) : f.type === "select" ? (
                <select id={fieldId} name={name} required={f.required}>
                  <option value="">{f.placeholder ?? "Selecciona una opción"}</option>
                  {opts.map((o) => <option value={o}>{o}</option>)}
                </select>
              ) : (
                <input
                  id={fieldId}
                  type={f.type ?? "text"}
                  name={name}
                  placeholder={f.placeholder ?? ""}
                  required={f.required}
                />
              )}
            </div>
          );
        })}

        {/* Honeypot — los bots lo llenan, los humanos no lo ven */}
        <div style="position:absolute;left:-9999px;opacity:0;pointer-events:none;height:0;overflow:hidden" aria-hidden="true">
          <input type="text" name="_hp_website" tabindex="-1" autocomplete="off" value="" />
        </div>

        {/* Turnstile widget */}
        {turnstileSiteKey && (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div>
        )}

        <div id={`${formId}-status`} class="form-status" aria-live="polite"></div>

        <button type="submit" class="form-btn">
          <span class="form-btn__label">{submitLabel}</span>
          <span class="form-btn__spinner" aria-hidden="true"></span>
        </button>
      </form>

    </div>
  </div>
</section>

{turnstileSiteKey && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
)}

<script is:inline>
  document.querySelectorAll("form[data-form-type]").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = e.target;
      const status = document.getElementById(f.id + "-status");
      const btn = f.querySelector(".form-btn");
      const label = btn.querySelector(".form-btn__label");
      const spinner = btn.querySelector(".form-btn__spinner");

      btn.disabled = true;
      label.style.opacity = "0";
      spinner.style.display = "block";
      status.textContent = "";
      status.className = "form-status";

      const data = Object.fromEntries(new FormData(f));

      try {
        const res = await fetch("/api/form-submit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            formType: f.dataset.formType,
            page: window.location.pathname,
            ...data,
          }),
        });

        if (res.ok) {
          status.textContent = f.dataset.success;
          status.className = "form-status form-status--ok";
          f.reset();
        } else {
          const d = await res.json().catch(() => ({}));
          status.textContent = d.error ?? "Ocurrió un error. Intenta de nuevo.";
          status.className = "form-status form-status--err";
        }
      } catch {
        status.textContent = "Error de conexión. Intenta de nuevo.";
        status.className = "form-status form-status--err";
      }

      btn.disabled = false;
      label.style.opacity = "1";
      spinner.style.display = "none";
    });
  });
</script>

<style>
  /* ── Grid dos columnas ── */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 64px;
    align-items: start;
  }

  @media (max-width: 780px) {
    .form-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  /* ── Columna izquierda ── */
  .form-copy__title {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.15;
    margin: 0 0 18px;
  }

  .form-copy__sub {
    opacity: .72;
    line-height: 1.7;
    font-size: 15px;
    margin: 0 0 32px;
  }

  .wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-radius: 12px;
    background: #25d366;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: .95rem;
    transition: opacity .2s;
  }
  .wa-btn:hover { opacity: .88; }

  /* ── Tarjeta del formulario — base (fondo oscuro / transparente) ── */
  .form-card {
    background: rgba(255,255,255,.10);
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 20px;
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: 13px; font-weight: 600; opacity: .85; }

  .field input,
  .field select,
  .field textarea {
    padding: 11px 14px;
    border-radius: 10px;
    border: 1.5px solid rgba(255,255,255,.30);
    background: rgba(255,255,255,.06);
    color: inherit;
    font-size: 14px;
    font-family: inherit;
    transition: border-color .2s, box-shadow .2s, background .2s;
    resize: vertical;
  }

  .field input::placeholder,
  .field select::placeholder,
  .field textarea::placeholder { opacity: .5; color: inherit; }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: #FFD700;
    box-shadow: 0 0 0 3px rgba(247,233,106,.20);
    background: rgba(255,255,255,.10);
  }

  /* ── Fondo claro (blanco, amarillo, transparente sobre blanco) ── */
  .section--on-light .form-card {
    background: rgba(0,0,0,.06);
    border-color: rgba(0,0,0,.14);
  }
  .section--on-light .field input,
  .section--on-light .field select,
  .section--on-light .field textarea {
    background: #fff;
    border-color: rgba(0,0,0,.22);
    color: #000;
  }
  .section--on-light .field input::placeholder,
  .section--on-light .field textarea::placeholder { color: rgba(0,0,0,.4); opacity: 1; }
  .section--on-light .field input:focus,
  .section--on-light .field select:focus,
  .section--on-light .field textarea:focus {
    border-color: #000;
    box-shadow: 0 0 0 3px rgba(0,0,0,.10);
    background: #fff;
  }

  /* ── Botón ── */
  .form-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 13px 24px;
    border-radius: 12px;
    border: none;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity .2s;
    min-height: 48px;
  }
  .form-btn:hover:not(:disabled) { opacity: .88; }
  .form-btn:disabled { opacity: .5; cursor: not-allowed; }

  /* Color contrario al fondo, texto = color del fondo */
  .section .form-btn,
  .section--on-dark .form-btn { background: #FFD700; color: var(--section-bg, #000); }
  .section--on-light .form-btn { background: #000; color: var(--section-bg, #fff); }

  /* Evita que el CSS global sobreescriba el color del texto del botón */
  .form-btn .form-btn__label { color: inherit !important; }

  .form-btn__spinner {
    display: none;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(0,0,0,.2);
    border-top-color: #000;
    border-radius: 50%;
    animation: spin .7s linear infinite;
    position: absolute;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Estado ── */
  .form-status {
    font-size: 14px;
    padding: 10px 14px;
    border-radius: 8px;
    display: none;
  }
  .form-status:not(:empty)        { display: block; }
  .form-status--ok  { background: #dcfce7; color: #166534; }
  .form-status--err { background: #fee2e2; color: #991b1b; }
</style>
