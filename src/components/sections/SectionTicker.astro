---
type Props = {
  bgColor?: string;
  textColor?: string;
  col1Text?: string;
  col2Text?: string;
  settings?: { sectionId?: string };
};

const {
  bgColor = "#fef0dc",
  textColor = "#96460a",
  col1Text,
  col2Text,
  settings,
} = Astro.props as Props;

const sectionId = settings?.sectionId;
const hasContent = Boolean(col1Text || col2Text);
---

{hasContent && (
  <section id={sectionId} class="ticker" style={`background:${bgColor};color:${textColor}`}>
    <div class="ticker__col">{col1Text}</div>
    <div class="ticker__col">{col2Text}</div>
  </section>
)}

<style>
  .ticker {
    display: flex;
    align-items: center;
    min-height: 50px;
    width: 100%;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: .01em;
    animation: ticker-fade-in 0.6s ease-out;
  }
  .ticker__col {
    flex: 0 0 50%;
    max-width: 50%;
    text-align: center;
    padding: 9px 16px;
  }

  @media (max-width: 640px) {
    .ticker { flex-direction: column; }
    .ticker__col { flex: 0 0 100%; max-width: 100%; padding: 6px 16px; }
  }

  @keyframes ticker-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
