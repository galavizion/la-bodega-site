---
import { urlFor } from "../../lib/sanity/image";

type CardItem = {
  _key?: string;
  badge?: string;
  image?: any;
  title?: string;
  description?: string;
  linkLabel?: string;
  linkUrl?: string;
};

type Props = {
  title?: string;
  subtitle?: string;
  columns?: number;
  cardStyle?: "shadow" | "outline" | "filled" | "minimal" | "circular";
  bgColor?: string;
  textAlign?: "left" | "center" | "right";
  items?: CardItem[] | null;
  cta?: { label?: string; url?: string } | null;
  settings?: { sectionId?: string };
};

const {
  title,
  subtitle,
  columns = 3,
  cardStyle = "shadow",
  bgColor,
  textAlign = "left",
  items,
  cta,
  settings,
} = Astro.props as Props;

const sectionId = settings?.sectionId;
const safeItems = Array.isArray(items) ? items.filter(Boolean) : [];
const cols = [2, 3, 4, 6, 12].includes(columns) ? columns : 3;

const bg = bgColor && bgColor !== "none" ? bgColor : null;
const bgStyle = bg ? `background-color:${bg}` : undefined;
const bgTheme = bg === "#000000" ? "section--on-dark"
  : (bg === "#ffffff" || bg?.toLowerCase() === "#FFD700") ? "section--on-light"
  : "";
---

<section id={sectionId} class={`section cards cards--${cardStyle} ${bgTheme}`} style={bgStyle}>
  <div class="container">
    {(title || subtitle) && (
      <header class="cards__header" style={`text-align:${textAlign}`}>
        {title    && <h2 class="cards__title">{title}</h2>}
        {subtitle && <p  class="cards__subtitle">{subtitle}</p>}
      </header>
    )}

    <div class={`cards__grid cards__grid--${cols}`}>
      {safeItems.map((item) => {
        const imgUrl = item.image
          ? urlFor(item.image).width(800).quality(85).auto("format").url()
          : null;

        return (
          <article class="card" style={`text-align:${textAlign};align-items:${textAlign === "center" ? "center" : textAlign === "right" ? "flex-end" : "flex-start"}`}>
            {imgUrl && (
              <div class="card__img-wrap">
                <img src={imgUrl} alt={item.title ?? ""} loading="lazy" />
              </div>
            )}
            <div class="card__body">
              {item.badge && <span class="card__badge">{item.badge}</span>}
              {item.title && <h3 class="card__title">{item.title}</h3>}
              {item.description && <p class="card__desc">{item.description}</p>}
              {item.linkUrl && item.linkLabel && (
                <a class="card__link" href={item.linkUrl}>{item.linkLabel} →</a>
              )}
            </div>
          </article>
        );
      })}
    </div>

    {cta?.label && cta?.url && (
      <div class="cards__cta">
        <a class="btn btn--primary" href={cta.url}>{cta.label}</a>
      </div>
    )}
  </div>
</section>

<style>
  .cards { width: 100%; }
  .cards__cta { margin-top: 36px; }

  /* Texto según luminosidad del fondo */

  .cards__header { text-align: left; margin-bottom: 36px; }
  .cards__title  { font-size: clamp(1.5rem, 3vw, 2.2rem); margin: 0 0 10px; }
  .cards__subtitle { opacity: .65; font-size: 1.05rem; line-height: 1.6; margin: 0; }

  .cards__grid {
    display: grid;
    gap: 28px;
  }
  .cards__grid--2  { grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr)); }
  .cards__grid--3  { grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .cards__grid--4  { grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); }
  .cards__grid--6  { grid-template-columns: repeat(auto-fill, minmax(min(100%, 140px), 1fr)); }
  .cards__grid--12 { grid-template-columns: repeat(auto-fill, minmax(min(100%, 80px),  1fr)); align-items: center; }
  .cards__grid--12 .card { align-items: center; justify-content: center; }
  .cards__grid--12 .card__img-wrap { display: flex; align-items: center; justify-content: center; }
  .cards__grid--12 .card__img-wrap img { width: auto; max-width: 100%; height: auto; }

  /* Base card — sin fondo, sin borde, sin border-radius */
  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Quitar cualquier estilo visual por variante */
  .cards--shadow .card,
  .cards--outline .card,
  .cards--filled .card,
  .cards--minimal .card {
    background: transparent;
    box-shadow: none;
    border: none;
    border-radius: 0;
    color: inherit;
  }

  /* Imagen: ancho completo, alto natural, sin crop, sin zoom */
  .card__img-wrap {
    width: 100%;
    overflow: visible;
  }
  .card__img-wrap img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── Estilo circular ── */
  .cards--circular .card {
    background: transparent;
    box-shadow: none;
    border: none;
    border-radius: 0;
    align-items: center;
    text-align: center;
  }

  .cards--circular .card__img-wrap {
    width: 40%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.25);
    margin: 0 auto;
  }

  .section--on-light .cards--circular .card__img-wrap {
    border-color: rgba(0,0,0,.18);
  }

  .cards--circular .card__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cards--circular .card__body {
    align-items: center;
    text-align: center;
  }

  /* Texto alineado a la izquierda, sin padding lateral */
  .card__body {
    padding: 14px 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }

  .card__badge {
    display: inline-block;
    background: var(--color-accent, #ef4444);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 99px;
    text-transform: uppercase;
    letter-spacing: .04em;
    width: fit-content;
  }
  .card__title { font-size: 1rem; font-weight: 700; margin: 0; line-height: 1.3; }
  .card__desc  { font-size: .875rem; line-height: 1.6; opacity: .7; margin: 0; }
  .card__link  {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: .85rem;
    font-weight: 600;
    color: var(--color-accent, #ef4444);
    text-decoration: none;
    margin-top: 4px;
  }
  .card__link:hover { text-decoration: underline; }
</style>
