---
import { urlFor } from "../../lib/sanity/image";

type Props = {
  visualStyle?: "default" | "bg-image" | "map";
  heading?: string;
  subheading?: string;
  bullets?: any[];
  image?: any;
  bgColor?: string;
  bgImage?: any;
  aspectRatio?: string;
  bgOverlay?: number;
  centerImage?: any;
  mapUrl?: string;
  mapFullWidth?: boolean;
  fullWidth?: boolean;
  textAlign?: "left" | "center" | "right";
  primaryCta?: { label?: string; url?: string };
  secondaryCta?: { label?: string; url?: string };
  settings?: { sectionId?: string };
};

const {
  visualStyle = "default",
  heading,
  subheading,
  bullets,
  image,
  bgColor,
  bgImage,
  aspectRatio = "16/6",
  bgOverlay = 40,
  centerImage,
  mapUrl,
  mapFullWidth = false,
  fullWidth = false,
  textAlign = "left",
  primaryCta,
  secondaryCta,
  settings,
} = Astro.props as Props;

const sectionId = settings?.sectionId;

const bg = bgColor && bgColor !== "none" ? bgColor : null;
const bgTheme = bg === "#000000" ? "section--on-dark"
  : (bg === "#ffffff" || bg?.toLowerCase() === "#f7e96a") ? "section--on-light"
  : "section--on-dark"; // default: transparent over dark body = white text

// ── Bullets ──────────────────────────────────────────────────────────────────
const safeBullets: string[] = Array.isArray(bullets)
  ? bullets.map((x) => {
      if (typeof x === "string") return x;
      if (typeof x?.text === "string") return x.text;
      if (Array.isArray(x?.children)) return x.children[0]?.text ?? "";
      return "";
    }).filter(Boolean)
  : [];

// ── Imágenes ─────────────────────────────────────────────────────────────────
const sideImgUrl = image
  ? urlFor(image).width(900).height(600).quality(80).auto("format").url()
  : null;

const bgImgUrl = bgImage
  ? urlFor(bgImage).width(1920).height(1080).quality(85).auto("format").url()
  : null;

const centerImgUrl = centerImage
  ? urlFor(centerImage).width(800).quality(85).auto("format").url()
  : null;

// ── Mapa ─────────────────────────────────────────────────────────────────────
let mapEmbedUrl: string | null = null;

if (visualStyle === "map" && mapUrl) {
  try {
    let resolved = mapUrl.trim();

    // Seguir el redirect de URLs cortas (maps.app.goo.gl / goo.gl)
    if (/goo\.gl/.test(resolved)) {
      const r = await fetch(resolved, {
        redirect: "follow",
        signal: AbortSignal.timeout(4000),
      });
      resolved = r.url;
    }

    // Extraer coordenadas del formato /@lat,lng,zoom
    const coords = resolved.match(/@(-?\d+\.\d+),(-?\d+\.\d+)/);
    if (coords) {
      mapEmbedUrl = `https://maps.google.com/maps?q=${coords[1]},${coords[2]}&output=embed&z=16&hl=es`;
    } else {
      // Fallback: incrustar URL tal como está
      mapEmbedUrl = resolved.includes("output=embed")
        ? resolved
        : `https://maps.google.com/maps?q=${encodeURIComponent(resolved)}&output=embed`;
    }
  } catch {
    mapEmbedUrl = null;
  }
}

const overlayOpacity = Math.min(90, Math.max(0, bgOverlay ?? 40)) / 100;

---

<!-- ══════════════════════════════════════════════════════════════════════════
     MODO 1: bg-image — imagen de fondo + contenido centrado
════════════════════════════════════════════════════════════════════════════ -->
{visualStyle === "bg-image" && (
  <section id={sectionId} class={`hero hero--bg-image section${fullWidth ? " hero--full" : ""}`} style={bgColor ? `--bg-color:${bgColor}` : undefined}>
    <div class={fullWidth ? undefined : "container"}>
      <div class={`hero-bg__frame${fullWidth ? " hero-bg__frame--full" : ""}`} style={`--overlay:${overlayOpacity};--aspect:${aspectRatio === "auto" ? "unset" : aspectRatio}`}>

        {bgImgUrl && (
          <img class="hero-bg__img" src={bgImgUrl} alt="" aria-hidden="true" loading="eager" />
        )}

        <div class="hero-bg__overlay" aria-hidden="true"></div>

        <div class="hero-bg__content">
          <div class="hero__copy hero__copy--center">
            {heading    && <h1>{heading}</h1>}
            {subheading && <p class="hero__sub">{subheading}</p>}

            {safeBullets.length > 0 && (
              <ul class="hero__bullets">
                {safeBullets.map((b) => <li>{b}</li>)}
              </ul>
            )}

            <div class="hero__cta">
              {primaryCta?.url   && <a class="btn btn--primary" href={primaryCta.url}>{primaryCta.label}</a>}
              {secondaryCta?.url && <a class="btn btn--ghost"   href={secondaryCta.url}>{secondaryCta.label}</a>}
            </div>
          </div>

          {centerImgUrl && (
            <div class="hero-bg__center-img">
              <img src={centerImgUrl} alt={heading ?? ""} loading="eager" />
            </div>
          )}
        </div>

      </div>
    </div>
  </section>
)}

<!-- ══════════════════════════════════════════════════════════════════════════
     MODO 2: default — texto izquierda, imagen derecha
════════════════════════════════════════════════════════════════════════════ -->
{(visualStyle === "default" || !visualStyle) && (
  <section id={sectionId} class={`hero hero--default section ${bgTheme}`} style={bg ? `background-color:${bg}` : undefined}>
    <div class="container hero__grid">
      <div class="hero__copy" style={`text-align:${textAlign}`}>
        {heading    && <h1>{heading}</h1>}
        {subheading && <p class="hero__sub">{subheading}</p>}

        {safeBullets.length > 0 && (
          <ul class="hero__bullets">
            {safeBullets.map((b) => <li>{b}</li>)}
          </ul>
        )}

        <div class="hero__cta">
          {primaryCta?.url   && <a class="btn btn--primary" href={primaryCta.url}>{primaryCta.label}</a>}
          {secondaryCta?.url && <a class="btn btn--ghost"   href={secondaryCta.url}>{secondaryCta.label}</a>}
        </div>
      </div>

      {sideImgUrl && (
        <div class="hero__visual">
          <img src={sideImgUrl} alt={heading ?? ""} width={900} height={600} loading="eager" />
        </div>
      )}
    </div>
  </section>
)}

<!-- ══════════════════════════════════════════════════════════════════════════
     MODO 3a: map full width — mapa full width, texto como overlay
════════════════════════════════════════════════════════════════════════════ -->
{visualStyle === "map" && mapFullWidth && (
  <section id={sectionId} class="hero hero--map">
    <div class="hero__map-bg">

      {mapEmbedUrl ? (
        <iframe
          src={mapEmbedUrl}
          title="Ubicación en Google Maps"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      ) : (
        <div class="hero__map-placeholder">
          <p>No se pudo cargar el mapa. Verifica el enlace.</p>
        </div>
      )}

      {(heading || subheading || safeBullets.length > 0 || primaryCta?.url || secondaryCta?.url) && (
        <>
          <div class="hero__map-gradient" aria-hidden="true"></div>
          <div class="hero__map-content container">
            <div class="hero__copy" style={`text-align:${textAlign}`}>
              {heading    && <h1>{heading}</h1>}
              {subheading && <p class="hero__sub">{subheading}</p>}
              {safeBullets.length > 0 && (
                <ul class="hero__bullets">
                  {safeBullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
              <div class="hero__cta">
                {primaryCta?.url   && <a class="btn btn--primary" href={primaryCta.url}>{primaryCta.label}</a>}
                {secondaryCta?.url && <a class="btn btn--ghost"   href={secondaryCta.url}>{secondaryCta.label}</a>}
              </div>
            </div>
          </div>
        </>
      )}

    </div>
  </section>
)}

<!-- ══════════════════════════════════════════════════════════════════════════
     MODO 3b: map 2 columnas — texto izquierda, mapa derecha
════════════════════════════════════════════════════════════════════════════ -->
{visualStyle === "map" && !mapFullWidth && (
  <section id={sectionId} class={`hero hero--map-split section ${bgTheme}`} style={bg ? `background-color:${bg}` : undefined}>
    <div class="container hero__grid">
      <div class="hero__copy" style={`text-align:${textAlign}`}>
        {heading    && <h1>{heading}</h1>}
        {subheading && <p class="hero__sub">{subheading}</p>}
        {safeBullets.length > 0 && (
          <ul class="hero__bullets">
            {safeBullets.map((b) => <li>{b}</li>)}
          </ul>
        )}
        <div class="hero__cta">
          {primaryCta?.url   && <a class="btn btn--primary" href={primaryCta.url}>{primaryCta.label}</a>}
          {secondaryCta?.url && <a class="btn btn--ghost"   href={secondaryCta.url}>{secondaryCta.label}</a>}
        </div>
      </div>

      <div class="hero__map-wrap">
        {mapEmbedUrl ? (
          <iframe
            src={mapEmbedUrl}
            title="Ubicación en Google Maps"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        ) : (
          <div class="hero__map-placeholder">
            <p>No se pudo cargar el mapa. Verifica el enlace.</p>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style>
  /* ── Shared ─────────────────────────────────────────────────────────────── */
  .hero {
    min-height: calc(40vh - var(--header-h, 0px));
    padding: 60px 0 80px;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: calc(20vh - var(--header-h, 0px));
      padding: 60px 0 80px;
    }
  }

  h1 {
    font-size: clamp(36px, 5vw, 64px);
    line-height: .95;
    letter-spacing: -1px;
    margin: 0 0 16px;
  }

  .hero__sub {
    font-size: 18px;
    line-height: 1.5;
    margin: 0 0 24px;
    opacity: .85;
  }

  .hero__bullets {
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
  }
  .hero__bullets li { opacity: .9; }

  .hero__cta { display: flex; gap: 16px; flex-wrap: wrap; }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 13px 22px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    transition: opacity .2s;
  }
  .btn:hover { opacity: .88; }
  .btn--primary { background: var(--color-accent, #ef4444); color: #fff; }
  .btn--ghost   { border: 1px solid rgba(255,255,255,.3); color: inherit; }

  /* ── Modo default & map: grid dos columnas ──────────────────────────────── */
  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 56px;
    align-items: center;
    height: 100%;
  }

  .section--on-light h1         { color: #000; }
  .section--on-light .btn--ghost { border-color: rgba(0,0,0,.2); color: #000; }
  .section--on-dark h1          { color: #fff; }
  .section--on-dark .hero__sub  { color: rgba(255,255,255,.85); }

  .hero__visual img {
    width: 100%;
    height: auto;
    border-radius: 18px;
    display: block;
  }

  /* ── Modo map 2 columnas ────────────────────────────────────────────────── */
  .hero__map-wrap {
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0,0,0,.2);
    height: 480px;
  }
  .hero__map-wrap iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* ── Modo map (full width) ───────────────────────────────────────────────── */
  .hero--map {
    padding: 0;
    min-height: unset;
  }

  .hero__map-bg {
    position: relative;
    width: 100%;
    height: 520px;
    overflow: hidden;
  }

  .hero__map-bg iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Gradiente izq→transparente para que el texto sea legible */
  .hero__map-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,.75) 0%, rgba(0,0,0,.45) 45%, transparent 72%);
    pointer-events: none;
    z-index: 1;
  }

  /* Contenido overlay centrado verticalmente */
  .hero__map-content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    z-index: 2;
  }

  .hero__map-content .hero__copy {
    max-width: 520px;
    color: #fff;
  }
  .hero__map-content h1          { color: #fff; }
  .hero__map-content .hero__sub  { color: rgba(255,255,255,.85); }
  .hero__map-content .btn--ghost { border-color: rgba(255,255,255,.4); }

  .hero__map-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: #1e293b;
    opacity: .8;
  }

  /* ── Modo bg-image ──────────────────────────────────────────────────────── */
  .hero--bg-image {
    background-color: var(--bg-color, transparent);
    color: #fff;
    padding: 0;
  }

  /* Full width: sin márgenes, sin border-radius */
  .hero--full { overflow: hidden; }

  /* Wrapper: aspect-ratio controla la altura, imagen cubre el frame */
  .hero-bg__frame {
    position: relative;
    width: 100%;
    aspect-ratio: var(--aspect, 16/6);
    border-radius: 18px;
    overflow: hidden;
    background-color: var(--bg-color, #1e293b);
  }

  /* Full width: sin border-radius */
  .hero-bg__frame--full {
    border-radius: 0;
  }

  /* Imagen: cubre todo el frame sin deformar */
  .hero-bg__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Overlay encima de la imagen */
  .hero-bg__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, var(--overlay, .4));
    pointer-events: none;
  }

  /* Contenido centrado sobre el overlay */
  .hero-bg__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
    padding: 48px 32px;
    z-index: 1;
  }

  .hero__copy--center {
    text-align: center;
    max-width: 720px;
  }
  .hero__copy--center h1              { color: #fff; }
  .hero__copy--center .hero__cta      { justify-content: center; }
  .hero__copy--center .btn--ghost     { border-color: rgba(255,255,255,.4); }

  .hero-bg__center-img img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;
  }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 32px;
      text-align: center;
    }
    .hero__cta { justify-content: center; }
    .hero__map-bg { height: 360px; }
    .hero__map-gradient {
      background: linear-gradient(to top, rgba(0,0,0,.8) 0%, rgba(0,0,0,.4) 55%, transparent 80%);
    }
    .hero__map-content {
      align-items: flex-end;
      padding-bottom: 24px;
    }
    .hero__map-content .hero__copy {
      max-width: 100%;
      text-align: center;
    }
    .hero__map-content .hero__cta { justify-content: center; }
  }
</style>
