---
interface Props {
  greeting?: string;
  botName?: string;
  avatarEmoji?: string;
}
const {
  greeting = "¡Hola! Soy Sparkly Fire, asistente de La Bodega del Instalador. ¿En qué puedo ayudarte?",
  botName = "Sparkly Fire",
  avatarEmoji = "🔥",
} = Astro.props;
---

<!-- Bubble -->
<button id="chatBubble" class="chat-bubble" aria-label="Abrir chat">
  <span class="chat-bubble__emoji">{avatarEmoji}</span>
  <span class="chat-bubble__close" style="display:none">✕</span>
</button>

<!-- Panel -->
<div id="chatPanel" class="chat-panel" style="display:none" role="dialog" aria-label="Chat asistente">
  <div class="chat-header">
    <span class="chat-header__avatar">{avatarEmoji}</span>
    <div>
      <div class="chat-header__name">{botName}</div>
      <div class="chat-header__status">En línea</div>
    </div>
    <button class="chat-header__close" id="chatClose" aria-label="Cerrar">✕</button>
  </div>

  <div class="chat-messages" id="chatMessages">
    <div class="chat-msg chat-msg--bot">
      <div class="chat-msg__bubble">{greeting}</div>
    </div>
  </div>

  <div class="chat-input-wrap">
    <input
      id="chatInput"
      class="chat-input"
      type="text"
      placeholder="Escribe tu pregunta…"
      maxlength="500"
      autocomplete="off"
    />
    <button id="chatSend" class="chat-send" aria-label="Enviar">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
      </svg>
    </button>
  </div>
</div>

<script is:inline define:vars={{ greeting, botName, avatarEmoji }}>
(function () {
  const bubble   = document.getElementById("chatBubble");
  const panel    = document.getElementById("chatPanel");
  const closeBtn = document.getElementById("chatClose");
  const input    = document.getElementById("chatInput");
  const sendBtn  = document.getElementById("chatSend");
  const msgs     = document.getElementById("chatMessages");

  // Historial de mensajes para la API
  const history = [];

  function togglePanel(open) {
    panel.style.display = open ? "flex" : "none";
    bubble.querySelector(".chat-bubble__emoji").style.display = open ? "none" : "inline";
    bubble.querySelector(".chat-bubble__close").style.display = open ? "inline" : "none";
    if (open) input.focus();
  }

  bubble.addEventListener("click", () => togglePanel(panel.style.display === "none"));
  closeBtn.addEventListener("click", () => togglePanel(false));

  function appendMsg(role, text) {
    const div = document.createElement("div");
    div.className = `chat-msg chat-msg--${role === "user" ? "user" : "bot"}`;
    const bubble = document.createElement("div");
    bubble.className = "chat-msg__bubble";
    bubble.innerHTML = text.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
                           .replace(/\n/g, "<br>");
    div.appendChild(bubble);
    msgs.appendChild(div);
    msgs.scrollTop = msgs.scrollHeight;
    return bubble;
  }

  function showTyping() {
    const div = document.createElement("div");
    div.className = "chat-msg chat-msg--bot chat-typing";
    div.innerHTML = '<div class="chat-msg__bubble"><span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span></div>';
    msgs.appendChild(div);
    msgs.scrollTop = msgs.scrollHeight;
    return div;
  }

  async function sendMessage() {
    const text = input.value.trim();
    if (!text) return;
    input.value = "";
    sendBtn.disabled = true;
    input.disabled = true;

    appendMsg("user", text);
    history.push({ role: "user", content: text });

    const typing = showTyping();

    try {
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history }),
      });

      typing.remove();

      if (!res.ok) throw new Error("Error del servidor");

      const data = await res.json();
      const reply = data.content || "Lo siento, no pude responder.";

      appendMsg("bot", reply);
      history.push({ role: "assistant", content: reply });

      // Ejecutar acciones de carrito si las hay
      if (data.cartActions && data.cartActions.length > 0) {
        data.cartActions.forEach(item => {
          window.Cart?.addItem({
            id:    item.id,
            title: item.title,
            slug:  item.slug,
            price: item.price,
            qty:   item.qty ?? 1,
            image: item.image ?? "",
            url:   `/catalogo/${item.slug}/`,
          });
        });
        // Notificación visual
        const notif = document.createElement("div");
        notif.className = "chat-msg chat-msg--bot";
        notif.innerHTML = `<div class="chat-msg__bubble chat-cart-notif">🛒 ${data.cartActions.length} producto(s) agregado(s) al carrito. <a href="/carrito/">Ver carrito →</a></div>`;
        msgs.appendChild(notif);
        msgs.scrollTop = msgs.scrollHeight;
      }
    } catch (err) {
      typing.remove();
      appendMsg("bot", "Ocurrió un error. Por favor intenta de nuevo.");
    }

    sendBtn.disabled = false;
    input.disabled = false;
    input.focus();
  }

  sendBtn.addEventListener("click", sendMessage);
  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendMessage(); }
  });
})();
</script>

<style>
  .chat-bubble {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: #111827;
    color: #fff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    box-shadow: 0 4px 20px rgba(0,0,0,.25);
    z-index: 9000;
    transition: transform .2s, box-shadow .2s;
  }
  .chat-bubble:hover { transform: scale(1.08); box-shadow: 0 6px 28px rgba(0,0,0,.3); }
  .chat-bubble__close { font-size: 16px; font-weight: 700; }

  .chat-panel {
    position: fixed;
    bottom: 90px;
    right: 24px;
    width: 340px;
    max-width: calc(100vw - 32px);
    height: 480px;
    max-height: calc(100vh - 120px);
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 8px 40px rgba(0,0,0,.18);
    z-index: 8999;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,.08);
  }

  .chat-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    background: #111827;
    color: #fff;
    flex-shrink: 0;
  }
  .chat-header__avatar { font-size: 24px; }
  .chat-header__name { font-weight: 700; font-size: 14px; }
  .chat-header__status { font-size: 11px; opacity: .7; }
  .chat-header__close {
    margin-left: auto;
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    font-size: 16px;
    opacity: .7;
    padding: 0 4px;
  }
  .chat-header__close:hover { opacity: 1; }

  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #f9fafb;
  }

  .chat-msg { display: flex; }
  .chat-msg--user { justify-content: flex-end; }
  .chat-msg--bot  { justify-content: flex-start; }

  .chat-msg__bubble {
    max-width: 80%;
    padding: 9px 13px;
    border-radius: 14px;
    font-size: 13px;
    line-height: 1.5;
  }
  .chat-msg--user .chat-msg__bubble {
    background: #111827;
    color: #fff;
    border-bottom-right-radius: 4px;
  }
  .chat-msg--bot .chat-msg__bubble {
    background: #fff;
    color: #111;
    border: 1px solid #e5e7eb;
    border-bottom-left-radius: 4px;
  }
  .chat-cart-notif {
    background: #f0fdf4 !important;
    border-color: #86efac !important;
    color: #166534 !important;
  }
  .chat-cart-notif a { color: #166534; font-weight: 700; }

  /* Typing indicator */
  .chat-typing .chat-msg__bubble {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 12px 14px;
  }
  .typing-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #9ca3af;
    animation: typingBounce 1.2s infinite ease-in-out;
  }
  .typing-dot:nth-child(2) { animation-delay: .2s; }
  .typing-dot:nth-child(3) { animation-delay: .4s; }
  @keyframes typingBounce {
    0%, 80%, 100% { transform: translateY(0); opacity: .5; }
    40% { transform: translateY(-5px); opacity: 1; }
  }

  .chat-input-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-top: 1px solid #e5e7eb;
    background: #fff;
    flex-shrink: 0;
  }
  .chat-input {
    flex: 1;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    padding: 9px 14px;
    font-size: 13px;
    outline: none;
    transition: border-color .15s;
  }
  .chat-input:focus { border-color: #111827; }
  .chat-send {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: #111827;
    color: #fff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background .15s;
  }
  .chat-send:hover:not(:disabled) { background: #374151; }
  .chat-send:disabled { opacity: .5; cursor: not-allowed; }

  @media (max-width: 480px) {
    .chat-panel { right: 8px; bottom: 84px; width: calc(100vw - 16px); }
    .chat-bubble { bottom: 16px; right: 16px; }
  }
</style>
