---
import "../styles/global.css";
import Header from "../components/Header.astro";
import ChatWidget from "../components/ChatWidget.astro";

import { sanityFetch } from "../lib/sanity/client";
import { SITE_SETTINGS_QUERY, PRODUCT_CATEGORIES_QUERY } from "../lib/sanity/queries";
import { resolveHref } from "../lib/nav";
import type { NavItem } from "../lib/types";

import {
  buildOrgSchema,
} from "../lib/seo/jsonld";



interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;

  seo?: {
    title?: string;
    description?: string;
    canonical?: string;
    noindex?: boolean;
    ogImage?: {
      asset?: {
        url?: string;
      };
    };
  };

  /** JSON-LD extra por página */
  schema?: Record<string, any> | Array<Record<string, any>>;

  /** Fondo editable desde Sanity */
  background?: {
    type?: "gradient" | "solid" | "image";
    color?: string;
    gradientColors?: string;
    image?: any;
    overlay?: number;
  };

  /** Clase extra en <body> — uso: "is-shop" para fondo blanco en tienda */
  bodyClass?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  seo,
  schema,
  background,
  bodyClass,
} = Astro.props as Props;

// ── Fondo dinámico ────────────────────────────────────────
const bgType = background?.type ?? "gradient";

const buildBodyBg = () => {
  if (bgType === "solid" && background?.color) {
    return `background:${background.color};animation:none;`;
  }
  if (bgType === "gradient" && background?.gradientColors) {
    const colors = background.gradientColors
      .split("\n")
      .map((c) => c.trim())
      .filter(Boolean)
      .join(", ");
    return `background:linear-gradient(-75deg,${colors});background-size:450% 450%;`;
  }
  return null; // usa el default de global.css
};
const bodyBgStyle = buildBodyBg();

const [settings, productCategories, chatProfile] = await Promise.all([
  sanityFetch<any>({ query: SITE_SETTINGS_QUERY }),
  sanityFetch<any[]>({ query: PRODUCT_CATEGORIES_QUERY }),
  import.meta.env.OPENAI_API_KEY
    ? sanityFetch<any>({ query: `*[_type == "chatbotProfile"][0]{ name, greeting, avatarEmoji, tone }` })
    : Promise.resolve(null),
]);
const categories: { _id: string; title: string; slug: string }[] = productCategories ?? [];
const footerNav: NavItem[] = settings?.navigation ?? [];

// Base
const siteUrl =
  settings?.siteUrl ||
  "https://www.labodegadelinstalador.net";

// SEO final con prioridad al bloque SEO de Sanity
const metaTitle =
  seo?.title ||
  title ||
  settings?.defaultTitle ||
  settings?.siteName ||
  "La Bodega del Instalador";

const metaDescription =
  seo?.description ||
  description ||
  settings?.defaultDescription ||
  "Materiales y suministros para instaladores profesionales.";

const metaCanonical =
  seo?.canonical ||
  canonical ||
  "https://www.labodegadelinstalador.net/";

const metaImage =
  seo?.ogImage?.asset?.url ||
  ogImage ||
  settings?.defaultOgImage?.asset?.url ||
  `${siteUrl}/og.jpg`;

const robots =
  seo?.noindex ? "noindex,nofollow" : "index,follow";

const tagManagerId = settings?.tagManagerId;
const analyticsId = settings?.analyticsId;
const adsenseClient = settings?.adsenseClient;
const searchConsoleVerification = settings?.searchConsoleVerification;

const gtmHeadScript = tagManagerId
  ? `(function(w,d,s,l,i){
      w[l]=w[l]||[];
      w[l].push({'gtm.start': new Date().getTime(), event:'gtm.js'});
      var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),
          dl=l!='dataLayer'?'&l='+l:'';
      j.async=true;
      j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
      f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',${JSON.stringify(tagManagerId)});`
  : "";

const gaScript = analyticsId
  ? `window.dataLayer = window.dataLayer || [];
     function gtag(){dataLayer.push(arguments);}
     gtag('js', new Date());
     gtag('config', ${JSON.stringify(analyticsId)});`
  : "";
// Siempre metemos Organization + lo extra de la página
const schemas = [
  buildOrgSchema(siteUrl, settings),
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
];
---

<!DOCTYPE html>
<html lang="es">
 <head>

  {tagManagerId && (
    <script is:inline set:html={gtmHeadScript}></script>
  )}

  {analyticsId && (
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}
    ></script>
  )}

  {analyticsId && (
    <script is:inline set:html={gaScript}></script>
  )}

  {searchConsoleVerification && (
    <meta
      name="google-site-verification"
      content={searchConsoleVerification}
    />
  )}

  {adsenseClient && (
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
      crossorigin="anonymous"
    ></script>
  )}

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{metaTitle}</title>

  <meta
    name="description"
    content={metaDescription}
  />

  <meta
    name="robots"
    content={robots}
  />

  <link
    rel="canonical"
    href={metaCanonical}
  />

  <!-- Open Graph -->
  <meta property="og:title" content={metaTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={metaCanonical} />
  <meta property="og:image" content={metaImage} />

  <!-- Schema JSON-LD -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schemas)}
  ></script>

  <script is:inline src="/scripts/cart.js" defer></script>

</head>
<body style={bodyBgStyle ?? undefined} class:list={[bodyClass ?? ""]}>
{bgType === "image" && background?.image?.asset && (
  <div
    class="page-bg-image"
    style={`--overlay:${(background.overlay ?? 0) / 100}`}
    aria-hidden="true"
  ></div>
)}

  {tagManagerId && (
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${tagManagerId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
  )}

  <Header showShopBar={true} />

  <div class="page-wrapper">

    <slot />


      <footer class="site-footer" role="contentinfo">

        {/* ── FILA 1: logo+matriz / categorías / nav / social ── */}
        <div class="footer__row1">
          <div class="container">
            <div class="footer__grid1">

              {/* Col 1 — Logo + Matriz */}
              <div class="footer__brand">
                <a href="/" aria-label="Ir al inicio" class="footer__logo-wrap">
                  <img
                    src={settings?.logoAltUrl ?? settings?.logoUrl ?? "/logo-bdi-negro.svg"}
                    alt={settings?.siteName ?? "BDI"}
                    height="46"
                    width="46"
                    loading="lazy"
                  />
                </a>

                {settings?.footerMatriz && (
                  <div class="footer__matriz">
                    {settings.footerMatriz.colTitle && (
                      <p class="footer__col-title">{settings.footerMatriz.colTitle}</p>
                    )}
                    {settings.footerMatriz.name && (
                      <p class="footer__matriz-name">{settings.footerMatriz.name}</p>
                    )}
                    {settings.footerMatriz.address && (
                      <p class="footer__contact-row">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        {settings.footerMatriz.address}
                      </p>
                    )}
                    {settings.footerMatriz.phone && (
                      <a class="footer__contact-row" href={`tel:${settings.footerMatriz.phone}`}>
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.12 6.12l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        {settings.footerMatriz.phone}
                      </a>
                    )}
                  </div>
                )}
              </div>

              {/* Col 2 — Categorías */}
              <nav class="footer__col" aria-label="Categorías">
                <p class="footer__col-title">{settings?.footerCategoriesTitle ?? "Categorías"}</p>
                {categories.length > 0 ? (
                  <ul class="footer__links">
                    {categories.map((cat) => (
                      <li><a href={`/catalogo?categoria=${cat.slug}`}>{cat.title}</a></li>
                    ))}
                  </ul>
                ) : (
                  <ul class="footer__links">
                    <li><a href="/catalogo">Ver catálogo</a></li>
                  </ul>
                )}
              </nav>

              {/* Col 3 — Nav del header (sin submenús) */}
              <nav class="footer__col" aria-label="Menú">
                <p class="footer__col-title">{settings?.footerNavTitle ?? "Menú"}</p>
                <ul class="footer__links">
                  {footerNav.map((item: NavItem) => (
                    <li><a href={resolveHref(item)}>{item.label}</a></li>
                  ))}
                </ul>
              </nav>

              {/* Col 4 — Redes + CTA */}
              <div class="footer__col footer__col--social">
                <p class="footer__col-title">{settings?.footerSocialTitle ?? "Síguenos"}</p>

                {settings?.social && (
                  <div class="footer__social" aria-label="Redes sociales">
                    {settings.social.facebook && (
                      <a href={settings.social.facebook} aria-label="Facebook" target="_blank" rel="noreferrer noopener">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                      </a>
                    )}
                    {settings.social.instagram && (
                      <a href={settings.social.instagram} aria-label="Instagram" target="_blank" rel="noreferrer noopener">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="18" cy="6" r="1"/></svg>
                      </a>
                    )}
                    {settings.social.tiktok && (
                      <a href={settings.social.tiktok} aria-label="TikTok" target="_blank" rel="noreferrer noopener">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
                      </a>
                    )}
                    {settings.social.youtube && (
                      <a href={settings.social.youtube} aria-label="YouTube" target="_blank" rel="noreferrer noopener">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
                      </a>
                    )}
                    {settings.social.whatsapp && (
                      <a href={settings.social.whatsapp} aria-label="WhatsApp" target="_blank" rel="noreferrer noopener">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                      </a>
                    )}
                    {settings.social.linkedin && (
                      <a href={settings.social.linkedin} aria-label="LinkedIn" target="_blank" rel="noreferrer noopener">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V9h4v2"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                      </a>
                    )}
                  </div>
                )}

                {(settings?.footerCtaUrl || settings?.organization?.whatsapp) && (
                  <a
                    href={settings?.footerCtaUrl ?? `https://wa.me/${settings?.organization?.whatsapp}`}
                    class="footer__cta-btn"
                  >
                    {settings?.footerCtaLabel ?? "Contáctanos"}
                  </a>
                )}
              </div>

            </div>
          </div>
        </div>

        {/* ── FILA 2: Sucursales ── */}
        {settings?.footerBranches?.length > 0 && (
          <div class="footer__row2">
            <div class="container">
              <div class="footer__grid2">
                {settings.footerBranches.slice(0, 4).map((b: any) => (
                  <div class="footer__branch">
                    {b.name && (
                      b.url ? (
                        <a href={b.url} class="footer__branch-name">
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                          {b.name}
                        </a>
                      ) : (
                        <p class="footer__branch-name">
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                          {b.name}
                        </p>
                      )
                    )}
                    {b.address && (
                      <p class="footer__branch-address">{b.address}</p>
                    )}
                    {b.phone && (
                      <a href={`tel:${b.phone}`} class="footer__branch-phone">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.12 6.12l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        {b.phone}
                      </a>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {/* ── BOTTOM BAR ── */}
        <div class="footer__bottom">
          <div class="container">
            <p class="footer__legal">
              {settings?.footerCopyright
                ? settings.footerCopyright
                : `© ${new Date().getFullYear()} ${settings?.siteName ?? ""}. Todos los derechos reservados.`}
            </p>
          </div>
        </div>

      </footer>
    </div>

    {import.meta.env.OPENAI_API_KEY && (
      <ChatWidget
        greeting={chatProfile?.greeting ?? "¡Hola! Soy Sparkly Fire, asistente de La Bodega del Instalador. ¿En qué puedo ayudarte?"}
        botName={chatProfile?.name ?? "Sparkly Fire"}
        avatarEmoji={chatProfile?.avatarEmoji ?? "🔥"}
        markupFactor={(settings?.usdRate ?? 17) * (1 + (settings?.markupPercent ?? 26.5) / 100)}
      />
    )}
  </body>
</html>

<style>
  /* ── FOOTER ─────────────────────────────────────────── */
  .site-footer {
    background: #000;
    color: #fff;
    font-size: 11px;
    margin-top: 60px;
    border-top: 1px solid rgba(255,255,255,.08);
  }

  /* ── Fila 1 ── */
  .footer__row1 { padding: 40px 0 32px; }

  .footer__grid1 {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr;
    gap: 32px;
    align-items: start;
  }

  /* Col 1 — brand */
  .footer__logo-wrap img { height: 46px; width: 46px; display: block; object-fit: contain; }
  .footer__logo-text { font-size: 16px; font-weight: 800; }

  .footer__matriz { margin-top: 16px; display: grid; gap: 6px; }
  .footer__matriz-name {
    font-weight: 700;
    font-size: 11px;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: rgba(255,255,255,.9);
    margin: 0;
  }

  .footer__contact-row {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    color: rgba(255,255,255,.65);
    margin: 0;
    line-height: 1.5;
    text-decoration: none;
    transition: color .15s;
  }
  .footer__contact-row svg { flex-shrink: 0; margin-top: 1px; opacity: .7; }
  a.footer__contact-row:hover { color: #FFD700; }

  /* Columnas genéricas */
  .footer__col { display: grid; gap: 0; align-content: start; }

  .footer__col-title {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: rgba(255,255,255,.45);
    margin: 0 0 12px;
  }

  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 7px;
  }
  .footer__links a {
    color: rgba(255,255,255,.70);
    text-decoration: none;
    transition: color .15s;
  }
  .footer__links a:hover { color: #FFD700; }

  /* Col 4 — social */
  .footer__social {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: rgba(255,215,0,.10);
    border: 1px solid rgba(255,215,0,.22);
    color: #FFD700;
    transition: background .15s;
  }
  .footer__social a:hover { background: rgba(255,215,0,.22); }

  .footer__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border-radius: 8px;
    background: #FFD700;
    color: #000;
    font-weight: 700;
    font-size: 11px;
    text-decoration: none;
    transition: opacity .2s;
    width: fit-content;
  }
  .footer__cta-btn:hover { opacity: .88; }

  /* ── Fila 2: Sucursales ── */
  .footer__row2 {
    border-top: 1px solid rgba(255,255,255,.08);
    padding: 24px 0;
  }

  .footer__grid2 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    align-items: start;
  }

  .footer__branch { display: grid; gap: 5px; }

  .footer__branch-name {
    display: flex;
    align-items: flex-start;
    gap: 5px;
    font-weight: 700;
    color: rgba(255,255,255,.9);
    text-decoration: none;
    margin: 0;
    line-height: 1.4;
    transition: color .15s;
  }
  a.footer__branch-name:hover { color: #FFD700; }
  .footer__branch-name svg { flex-shrink: 0; margin-top: 1px; color: #FFD700; }

  .footer__branch-address {
    color: rgba(255,255,255,.5);
    margin: 0;
    padding-left: 16px;
    line-height: 1.4;
  }

  .footer__branch-phone {
    display: flex;
    align-items: center;
    gap: 5px;
    color: rgba(255,255,255,.65);
    text-decoration: none;
    transition: color .15s;
  }
  .footer__branch-phone:hover { color: #FFD700; }
  .footer__branch-phone svg { color: rgba(255,255,255,.4); }

  /* ── Bottom bar ── */
  .footer__bottom {
    border-top: 1px solid rgba(255,255,255,.08);
    padding: 14px 0;
  }
  .footer__legal {
    margin: 0;
    color: rgba(255,255,255,.35);
    text-align: center;
    font-size: 10px;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .footer__grid1 {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .footer__grid2 {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 520px) {
    .footer__grid1 { grid-template-columns: 1fr; }
    .footer__grid2 { grid-template-columns: 1fr; }
  }

  /* ── FONDO DE IMAGEN ────────────────────────────────── */
  .page-bg-image {
    position: fixed;
    inset: 0;
    z-index: -1;
