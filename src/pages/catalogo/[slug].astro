---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { client as sanityClient } from "../../lib/sanity/client";
import { CATALOG_BY_SLUG, SITE_SETTINGS_QUERY } from "../../lib/sanity/queries";
import PortableTextRenderer from "../../components/PortableTextRenderer.astro";
import { urlFor } from "../../lib/sanity/image";
import { resolveMarkup } from "../../lib/pricing";

export const prerender = false;

const { slug } = Astro.params;
const [item, settings] = await Promise.all([
  sanityClient.fetch(CATALOG_BY_SLUG, { slug }),
  sanityClient.fetch(SITE_SETTINGS_QUERY),
]);

const catalogOnlyMode: boolean = settings?.catalogOnlyMode === true;
const shopCurrency: string = settings?.shopCurrency ?? "USD";
const usdRate: number = settings?.usdRate ?? 17;
const { unit: markupPercent, box: boxMarkupPercent } = resolveMarkup(item?.categoryPricing, settings, item);
const markupFactor = 1 + markupPercent / 100;
const toMXN = (n: number) => (shopCurrency === "USD" ? n * usdRate : n) * markupFactor;

const cover = item?.coverImage?.asset
  ? urlFor(item.coverImage).width(1600).quality(85).auto("format").url()
  : (item?.imageUrl ?? null);

const defaultPhone = (settings?.organization?.whatsapp ?? "528121087053").replace(/\D/g, "");
const phone = (item?.whatsapp?.phone || defaultPhone).replace(/\D/g, "");

const msg =
  item?.whatsapp?.message ||
  `Hola, quiero información de: ${item?.title ?? "un servicio"} (${Astro.url.pathname})`;

const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;

const formatMXN = (n: number) =>
  `$${n.toLocaleString("es-MX", { minimumFractionDigits: 0, maximumFractionDigits: 2 })} MXN`;

const variants: any[] = Array.isArray(item?.variants) ? item.variants : [];
const hasVariants = variants.length > 0;

// Precio base: primer variante con precio, o campo price, o priceLabel
const basePriceRaw =
  variants.find((v: any) => v.price != null)?.price ??
  item?.price ??
  null;

const basePrice = basePriceRaw != null ? toMXN(basePriceRaw) : null;

const priceText =
  basePrice != null ? formatMXN(basePrice) : item?.priceLabel || "Cotización personalizada";

// Opción de caja — precio calculado del precio unitario, con margen resuelto por categoría
const box = item?.boxOption?.enabled ? item.boxOption : null;
const toBoxMXN = (unitPrice: number, units: number) =>
  (shopCurrency === "USD" ? unitPrice * usdRate : unitPrice) * units * (1 + boxMarkupPercent / 100);
const basePriceForBox = basePriceRaw ?? null;
const boxPriceMXN = (box && basePriceForBox != null && box.unitsPerBox)
  ? toBoxMXN(basePriceForBox, box.unitsPerBox)
  : null;
const boxUnitPrice = (box?.unitsPerBox && boxPriceMXN) ? boxPriceMXN / box.unitsPerBox : null;

const siteUrl = "https://www.labodegadelinstalador.net";
const canonical = `${siteUrl}/catalogo/${slug}/`;
const pageTitle = item?.seo?.title || item?.title || "Catálogo";
const pageDesc =
  item?.seo?.description ||
  item?.excerpt ||
  "Producto del catálogo de La Bodega del Instalador.";

const schema: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: item?.title ?? "Producto",
  description: item?.excerpt ?? "Producto del catálogo de La Bodega del Instalador.",
  url: canonical,
  ...(cover ? { image: [cover] } : {}),
  brand: { "@type": "Brand", name: "La Bodega del Instalador" },
};

if (!catalogOnlyMode && basePrice != null) {
  schema.offers = {
    "@type": "Offer",
    price: Number(basePrice),
    priceCurrency: "MXN",
    url: canonical,
    availability: "https://schema.org/InStock",
  };
} else if (!catalogOnlyMode && item?.priceLabel) {
  schema.priceSpecification = {
    "@type": "PriceSpecification",
    description: String(item.priceLabel),
  };
}
---

<BaseLayout
  title={`${pageTitle} | La Bodega del Instalador`}
  description={pageDesc}
  canonical={canonical}
  seo={item?.seo}
  schema={schema}
  bodyClass="is-shop"
>
  <main class="product-wrap">
    <div class="container">
      <a class="back" href="/catalogo/">← Volver al catálogo</a>

      <section class="product">
        {/* MEDIA */}
        <div class="product__media">
          {cover ? (
            <img class="product__img" src={cover} alt={item?.title} loading="eager" />
          ) : (
            <div class="product__img product__img--placeholder" aria-hidden="true"></div>
          )}
        </div>

        {/* INFO */}
        <div class="product__info">
          {item?.category ? <span class="pill">{item.category}</span> : null}

          <h1 class="product__title">{item?.title}</h1>

          {item?.excerpt ? (
            <div class="product__excerpt" set:html={item.excerpt} />
          ) : null}

          {/* VARIANTES */}
          {hasVariants && (
            <div class="product__variants" id="variantsBox">
              <p class="variants__label">Selecciona una variante:</p>
              <div class="variants__grid">
                {variants.map((v: any, i: number) => {
                  const vLabel = v.size || v.label || v.sku || `Variante ${i + 1}`;
                  const vPrice = v.price != null ? formatMXN(v.price) : null;
                  return (
                    <button
                      class={`variant-btn${i === 0 ? " is-active" : ""}`}
                      type="button"
                      data-variant-btn
                      data-index={String(i)}
                      data-price={v.price != null ? String(v.price) : ""}
                      data-compare={v.comparePrice != null ? String(v.comparePrice) : ""}
                      data-sku={v.sku ?? ""}
                      data-label={vLabel}
                    >
                      <span class="variant-btn__name">{vLabel}</span>
                    </button>
                  );
                })}
              </div>
            </div>
          )}

          {/* Precio + opciones de cantidad */}
          {!catalogOnlyMode && (box ? (
            <div class="product__buy-options">
              {/* Fila unidad */}
              <div class="buy-row" id="buyRowUnit">
                <div class="buy-row__qty">
                  <button class="qty-btn" type="button" data-step="-1" data-target="qtyUnit">−</button>
                  <input class="qty-input" id="qtyUnit" type="number" value="0" min="0" max="999" readonly />
                  <button class="qty-btn" type="button" data-step="1" data-target="qtyUnit">+</button>
                </div>
                <div class="buy-row__price">
                  <span class="buy-row__main" id="priceDisplay">{priceText}</span>
                  <span class="buy-row__label">por pieza</span>
                </div>
              </div>

              {/* Fila caja */}
              {boxPriceMXN != null && (
                <div class="buy-row">
                  <div class="buy-row__qty">
                    <button class="qty-btn" type="button" data-step="-1" data-target="qtyBox">−</button>
                    <input class="qty-input" id="qtyBox" type="number" value="0" min="0" max="999" readonly />
                    <button class="qty-btn" type="button" data-step="1" data-target="qtyBox">+</button>
                  </div>
                  <div class="buy-row__price">
                    <span class="buy-row__main">{formatMXN(boxPriceMXN)}</span>
                    <span class="buy-row__label">
                      {box.boxLabel || `caja de ${box.unitsPerBox}`}
                      {boxUnitPrice != null && <> · {formatMXN(boxUnitPrice)} c/u</>}
                    </span>
                  </div>
                </div>
              )}

              {(hasVariants ? variants[0]?.comparePrice : item?.comparePrice) != null && (
                <div class="product__compare" id="compareDisplay">
                  Antes: <s>{formatMXN(toMXN(hasVariants ? variants[0].comparePrice : item.comparePrice))}</s>
                </div>
              )}

              <button class="btn btn--cart" type="button" id="addToCartBtn"
                data-title={item?.title ?? ""}
                data-slug={item?.slug ?? slug ?? ""}
                data-url={`/catalogo/${slug}/`}
                data-price={basePrice ?? 0}
                data-box-price={boxPriceMXN ?? 0}
                data-box-units={box.unitsPerBox ?? 0}
                data-box-label={box.boxLabel || `caja de ${box.unitsPerBox}`}
                data-image={cover ?? ""}
              >
                Agregar al carrito
              </button>
            </div>
          ) : (
            <>
              <div class="product__price" id="priceDisplay">{priceText}</div>
              {(hasVariants ? variants[0]?.comparePrice : item?.comparePrice) != null && (
                <div class="product__compare" id="compareDisplay">
                  Antes: <s>{formatMXN(toMXN(hasVariants ? variants[0].comparePrice : item.comparePrice))}</s>
                </div>
              )}
              <div class="product__cta">
                <button
                  class="btn btn--cart"
                  type="button"
                  data-add
                  data-title={item?.title ?? ""}
                  data-slug={item?.slug ?? slug ?? ""}
                  data-url={`/catalogo/${slug}/`}
                  data-price={basePrice ?? 0}
                  data-image={cover ?? ""}
                >
                  Agregar al carrito
                </button>
              </div>
            </>
          ))}

          <div class="product__trust">
            <div class="trust-item">
              <strong>Envío gratis</strong>
              <span>Desde 5,000 MXN</span>
            </div>
            <div class="trust-item">
              <strong>Asesoría técnica</strong>
              <span>Especialistas en instalaciones profesionales.</span>
            </div>
            <div class="trust-item">
              <strong>Precio de instalador</strong>
              <span>Precios directos para el profesional.</span>
            </div>
          </div>
        </div>
      </section>

      {/* DETALLES */}
      {(item?.body || (hasVariants && variants.some((v: any) => v.specifications?.length))) && (
        <section class="product-content">
          <h2 class="product-content__title">Detalles</h2>

          {item?.body && (
            <div class="prose">
              <PortableTextRenderer value={item.body} />
            </div>
          )}

          {/* Tabla de especificaciones de la variante activa */}
          {hasVariants && variants.some((v: any) => v.specifications?.length) && (
            <div id="specsContainer" class="specs-wrap">
              {variants.map((v: any, i: number) => (
                <table
                  class={`specs-table${i === 0 ? "" : " is-hidden"}`}
                  data-specs-idx={String(i)}
                >
                  <tbody>
                    {(v.specifications ?? []).map((s: any) => (
                      <tr>
                        <th>{s.label}</th>
                        <td>{s.value}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ))}
            </div>
          )}
        </section>
      )}
    </div>
  </main>

  <script is:inline define:vars={{ usdRate, shopCurrency, markupPercent }}>
    // ── Steppers de cantidad ──────────────────────────────
    document.addEventListener("click", (e) => {
      const btn = e.target?.closest?.("[data-step]");
      if (!btn) return;
      const targetId = btn.getAttribute("data-target");
      const input = document.getElementById(targetId);
      if (!input) return;
      const step = Number(btn.getAttribute("data-step"));
      const val = Math.max(0, (Number(input.value) || 0) + step);
      input.value = val;
    });

    // ── Carrito con box ───────────────────────────────────
    const addBtn = document.getElementById("addToCartBtn");
    if (addBtn) {
      addBtn.addEventListener("click", () => {
        const title    = addBtn.getAttribute("data-title") || "";
        const slug     = addBtn.getAttribute("data-slug")  || "";
        const url      = addBtn.getAttribute("data-url")   || "";
        const image    = addBtn.getAttribute("data-image") || "";
        const price    = Number(addBtn.getAttribute("data-price")    || 0);
        const boxPrice = Number(addBtn.getAttribute("data-box-price") || 0);
        const boxUnits = Number(addBtn.getAttribute("data-box-units") || 0);
        const boxLabel = addBtn.getAttribute("data-box-label") || "";

        const qtyUnit = Number(document.getElementById("qtyUnit")?.value || 0);
        const qtyBox  = Number(document.getElementById("qtyBox")?.value  || 0);

        if (qtyUnit === 0 && qtyBox === 0) {
          document.getElementById("qtyUnit").focus();
          return;
        }

        if (qtyUnit > 0) {
          window.Cart?.addItem({ title, slug, url, image, price, qty: qtyUnit });
        }
        if (qtyBox > 0 && boxPrice > 0) {
          window.Cart?.addItem({
            title: `${title} — ${boxLabel}`,
            slug: `${slug}--caja`,
            url,
            image,
            price: boxPrice,
            qty: qtyBox,
            variantLabel: boxLabel,
            isBox: true,
          });
        }

        addBtn.textContent = "Agregado ✅";
        if (document.getElementById("qtyUnit"))  document.getElementById("qtyUnit").value  = "0";
        if (document.getElementById("qtyBox"))   document.getElementById("qtyBox").value   = "0";
        setTimeout(() => (addBtn.textContent = "Agregar al carrito"), 1600);
      });
    }

    // ── Carrito simple (sin box) ──────────────────────────
    document.addEventListener("click", (e) => {
      const btn = e.target?.closest?.("[data-add]");
      if (!btn) return;
      const title = btn.getAttribute("data-title") || "";
      const slug  = btn.getAttribute("data-slug")  || "";
      const url   = btn.getAttribute("data-url")   || "";
      const image = btn.getAttribute("data-image") || "";
      const price = Number(btn.getAttribute("data-price") || 0);
      if (!slug) return;
      window.Cart?.addItem({ title, slug, url, image, price });
      btn.textContent = "Agregado ✅";
      setTimeout(() => (btn.textContent = "Agregar al carrito"), 1400);
    });

    // ── Variantes ────────────────────────────────────────
    const variantBtns = document.querySelectorAll("[data-variant-btn]");
    const priceDisplay   = document.getElementById("priceDisplay");
    const compareDisplay = document.getElementById("compareDisplay");

    variantBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        variantBtns.forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");

        const price   = btn.getAttribute("data-price");
        const compare = btn.getAttribute("data-compare");
        const idx     = btn.getAttribute("data-index");

        const rate = (shopCurrency === "USD" ? usdRate : 1) * (1 + markupPercent / 100);

        if (priceDisplay) {
          if (price) {
            const n = Number(price) * rate;
            priceDisplay.textContent = "$" + n.toLocaleString("es-MX", { minimumFractionDigits: 0, maximumFractionDigits: 2 }) + " MXN";
          } else {
            priceDisplay.textContent = "Cotización personalizada";
          }
        }

        if (compareDisplay) {
          if (compare) {
            compareDisplay.style.display = "block";
            const cn = Number(compare) * rate;
            compareDisplay.innerHTML = "Antes: <s>$" + cn.toLocaleString("es-MX", { minimumFractionDigits: 0, maximumFractionDigits: 2 }) + " MXN</s>";
          } else {
            compareDisplay.style.display = "none";
          }
        }

        // Mostrar tabla de specs correspondiente
        document.querySelectorAll("[data-specs-idx]").forEach((t) => {
          t.classList.toggle("is-hidden", t.getAttribute("data-specs-idx") !== idx);
        });
      });
    });
  </script>

  <style>
    .product-wrap {
      padding-top: calc(var(--header-h, 80px) + 36px);
      padding-bottom: 70px;
      color: #333;
    }

    .back {
      display: inline-block;
      opacity: .75;
      text-decoration: none;
      font-size: 13px;
      margin-bottom: 20px;
    }
    .back:hover { opacity: 1; }

    .product {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 46px;
      align-items: start;
      margin-top: 4px;
    }

    .product__media {
      position: sticky;
      top: calc(var(--header-h, 80px) + 18px);
      align-self: start;
    }

    .product__img {
      width: 100%;
      aspect-ratio: 1 / 1;
      height: auto;
      object-fit: contain;
      border-radius: 0;
      display: block;
      background: #f3f4f6;
    }
    .product__img--placeholder {
      background: #e5e7eb;
    }

    .product__info { padding-top: 4px; }

    .pill {
      display: inline-flex;
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(17,24,39,.08);
      font-size: 11px;
      letter-spacing: .06em;
      text-transform: uppercase;
      margin-bottom: 10px;
    }

    .product__title {
      margin: 0 0 10px;
      font-size: clamp(24px, 3vw, 36px);
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: #111;
    }

    .product__excerpt {
      margin: 0 0 16px;
      color: #4b5563;
      font-size: 14px;
      line-height: 1.6;
    }
    .product__excerpt p { margin: 0 0 6px; }
    .product__excerpt p:last-child { margin-bottom: 0; }

    /* Variantes */
    .product__variants { margin-bottom: 16px; }
    .variants__label {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: #6b7280;
      margin: 0 0 8px;
    }
    .variants__grid {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .variant-btn {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      padding: 8px 14px;
      border: 1.5px solid #d1d5db;
      border-radius: 8px;
      background: #fff;
      cursor: pointer;
      transition: border-color .15s, background .15s;
      font-size: 13px;
      color: #374151;
      min-width: 60px;
    }
    .variant-btn:hover { border-color: #111; }
    .variant-btn.is-active {
      border-color: #111;
      background: #111;
      color: #fff;
    }
    .variant-btn__name { font-weight: 700; line-height: 1.2; }
    .variant-btn__price { font-size: 11px; opacity: .8; margin-top: 2px; }
    .variant-btn.is-active .variant-btn__price { opacity: .75; }

    .product__price {
      font-size: 28px;
      font-weight: 300;
      color: #660202;
      margin-bottom: 4px;
    }
    .product__compare {
      font-size: 13px;
      color: #9ca3af;
      margin-bottom: 12px;
    }

    .product__cta {
      margin-top: 16px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    /* Buy options (con caja) */
    .product__buy-options {
      margin-top: 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .buy-row {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 12px 14px;
      border: 1px solid #e5e7eb;
      background: #fafafa;
    }
    .buy-row__qty {
      display: flex;
      align-items: center;
      gap: 0;
      border: 1px solid #d1d5db;
      background: #fff;
      flex-shrink: 0;
    }
    .qty-btn {
      width: 32px;
      height: 36px;
      border: none;
      background: none;
      font-size: 18px;
      cursor: pointer;
      color: #374151;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background .1s;
    }
    .qty-btn:hover { background: #f3f4f6; }
    .qty-input {
      width: 44px;
      height: 36px;
      border: none;
      border-left: 1px solid #e5e7eb;
      border-right: 1px solid #e5e7eb;
      text-align: center;
      font-size: 15px;
      font-weight: 700;
      background: #fff;
      -moz-appearance: textfield;
    }
    .qty-input::-webkit-outer-spin-button,
    .qty-input::-webkit-inner-spin-button { -webkit-appearance: none; }
    .buy-row__price { flex: 1; }
    .buy-row__main {
      display: block;
      font-size: 20px;
      font-weight: 700;
      color: #660202;
      line-height: 1.2;
    }
    .buy-row__label {
      display: block;
      font-size: 12px;
      color: #6b7280;
      margin-top: 2px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 14px 22px;
      border-radius: 0;
      text-decoration: none;
      font-weight: 700;
      font-size: 14px;
      border: 0;
      cursor: pointer;
      transition: background .15s, transform .1s;
      user-select: none;
    }
    .btn--wa { background: #25d366; color: #fff; }
    .btn--wa:hover { background: #1ebe5d; transform: translateY(-1px); }
    .btn--cart { background: #111827; color: #fff; border: 2px solid #111827; }
    .btn--cart:hover { background: #1f2937; transform: translateY(-1px); }

    .product__trust {
      margin-top: 22px;
      display: grid;
      gap: 10px;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      padding: 14px;
    }
    .trust-item strong { display: block; font-size: 13px; margin-bottom: 2px; color: #111; }
    .trust-item span   { display: block; font-size: 12px; color: #6b7280; line-height: 1.4; }

    /* Detalles */
    .product-content {
      margin-top: 50px;
      padding-top: 28px;
      border-top: 1px solid #e5e7eb;
    }
    .product-content__title {
      margin: 0 0 18px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: #9ca3af;
    }
    .prose {
      color: #374151;
      font-size: 15px;
      line-height: 1.7;
    }
    .prose h2, .prose h3 { color: #111; margin: 1.4em 0 .5em; }
    .prose p  { margin: 0 0 .9em; }
    .prose ul, .prose ol { padding-left: 1.4em; margin: 0 0 .9em; }

    /* Especificaciones */
    .specs-wrap { margin-top: 24px; }
    .specs-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .specs-table th, .specs-table td {
      text-align: left;
      padding: 8px 12px;
      border-bottom: 1px solid #e5e7eb;
    }
    .specs-table th { color: #6b7280; font-weight: 600; width: 40%; }
    .specs-table td { color: #111; }
    .specs-table.is-hidden { display: none; }

    /* Mobile */
    @media (max-width: 900px) {
      .product {
        grid-template-columns: 1fr;
        gap: 20px;
      }
      .product__media { position: static; }
      .product__img   { height: auto; }
      .product__title { font-size: 26px; }
      .product__price { font-size: 22px; }
      .btn { width: 100%; }
    }
  </style>
</BaseLayout>
