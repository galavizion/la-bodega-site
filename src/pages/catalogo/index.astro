---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { client as sanityClient } from "../../lib/sanity/client";
import { SITE_SETTINGS_QUERY } from "../../lib/sanity/queries";
import { urlFor } from "../../lib/sanity/image";
import { resolveMarkup } from "../../lib/pricing";
import groq from "groq";

type CatalogItem = {
  _id: string;
  title: string;
  slug: string;
  excerpt?: string;
  coverImage?: any;
  imageUrl?: string;
  price?: number;
  priceLabel?: string;
  familySlug?: string;
  familyCount?: number;
  whatsapp?: { enabled?: boolean; phone?: string; message?: string };
  boxOption?: { enabled?: boolean; unitsPerBox?: number; boxMarkupPercent?: number; boxLabel?: string };
  categoryPricing?: { markupPercent?: number; boxMarkupPercent?: number; parentMarkupPercent?: number; parentBoxMarkupPercent?: number };
  disableMarkup?: boolean;
};

const PAGE_SIZE = 20;
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? 1));
const q = (Astro.url.searchParams.get("q") ?? "").trim();
const from = (page - 1) * PAGE_SIZE;
const to = from + PAGE_SIZE;

const baseFilter = `_type == "catalogItem" && defined(slug.current) && published != false && (!defined(familySlug) || isFamilyRepresentative == true)`;
const searchFilter = q ? ` && (title match $q + "*" || excerpt match $q + "*")` : "";

const query = groq`{
  "items": *[${baseFilter}${searchFilter}] | order(_createdAt desc) [$from...$to] {
    _id,
    title,
    "slug": slug.current,
    excerpt,
    coverImage,
    imageUrl,
    price,
    priceLabel,
    familySlug,
    "familyCount": select(
      defined(familySlug) => count(*[_type=="catalogItem" && familySlug==^.familySlug && published!=false]),
      0
    ),
    "categoryPricing": category->{
      markupPercent,
      boxMarkupPercent,
      "parentMarkupPercent": parent->markupPercent,
      "parentBoxMarkupPercent": parent->boxMarkupPercent
    },
    disableMarkup,
    boxOption{ enabled, unitsPerBox, boxMarkupPercent, boxLabel },
    whatsapp{ enabled, phone, message }
  },
  "total": count(*[${baseFilter}${searchFilter}])
}`;

const [{ items, total }, settings] = await Promise.all([
  sanityClient.fetch<{ items: CatalogItem[]; total: number }>(query, { q, from, to }),
  sanityClient.fetch(SITE_SETTINGS_QUERY),
]);

const catalogOnlyMode: boolean = settings?.catalogOnlyMode === true;

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

const img = (item: CatalogItem): string | null => {
  if (item.coverImage?.asset) {
    return urlFor(item.coverImage).width(600).quality(80).auto("format").url();
  }
  return item.imageUrl ?? null;
};

const shopCurrency: string = settings?.shopCurrency ?? "USD";
const usdRate: number = settings?.usdRate ?? 17;
const toMXN = (n: number, item: CatalogItem) => {
  const { unit } = resolveMarkup(item.categoryPricing, settings, item);
  return (shopCurrency === "USD" ? n * usdRate : n) * (1 + unit / 100);
};
const toBoxMXN = (unitPrice: number, units: number, item: CatalogItem) => {
  const { box } = resolveMarkup(item.categoryPricing, settings, item);
  return (shopCurrency === "USD" ? unitPrice * usdRate : unitPrice) * units * (1 + box / 100);
};
const formatMXN = (n: number) => `$${n.toLocaleString("es-MX", { maximumFractionDigits: 2 })} MXN`;

const DEFAULT_PHONE = (settings?.organization?.whatsapp ?? "528121087053").replace(/\D/g, "");
const waLink = (item: CatalogItem) => {
  const phone = (item.whatsapp?.phone || DEFAULT_PHONE).replace(/\D/g, "");
  const msg = item.whatsapp?.message || `Hola, me interesa: ${item.title}`;
  return `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
};

const pageUrl = (p: number) => {
  const params = new URLSearchParams();
  if (q) params.set("q", q);
  if (p > 1) params.set("page", String(p));
  const qs = params.toString();
  return `/catalogo/${qs ? "?" + qs : ""}`;
};

function paginationRange(current: number, total: number): (number | "…")[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const pages: (number | "…")[] = [1];
  if (current > 3) pages.push("…");
  for (let p = Math.max(2, current - 1); p <= Math.min(total - 1, current + 1); p++) {
    pages.push(p);
  }
  if (current < total - 2) pages.push("…");
  pages.push(total);
  return pages;
}

const pgRange = paginationRange(page, totalPages);
---

<BaseLayout
  title="Tienda | La Bodega del Instalador"
  canonical="https://www.labodegadelinstalador.net/catalogo/"
  bodyClass="is-shop"
>
  <!-- Encabezado + búsqueda -->
  <div class="catalog-header">
    <div class="container">
      <div class="catalog-header__top">
        <div>
          <h1 class="catalog-title">Tienda</h1>
          <p class="catalog-subtitle">
            {total} producto{total !== 1 ? "s" : ""} disponibles
          </p>
        </div>
      </div>

      <form class="search-form" method="get" action="/catalogo/" role="search">
        <div class="search-wrap">
          <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            class="search-input"
            type="search"
            name="q"
            value={q}
            placeholder="Buscar producto, material, marca…"
            autocomplete="off"
          />
          {q && (
            <a href="/catalogo/" class="search-clear" aria-label="Limpiar búsqueda">✕</a>
          )}
        </div>
        <button class="search-btn" type="submit">Buscar</button>
      </form>
    </div>
  </div>

  <main class="container catalog-main">
    {q && (
      <p class="search-results-label">
        {total > 0
          ? `${total} resultado${total !== 1 ? "s" : ""} para "${q}"`
          : `Sin resultados para "${q}"`}
        {" — "}<a href="/catalogo/">Ver todo</a>
      </p>
    )}

    {items.length > 0 ? (
      <div class="grid">
        {items.map((item) => {
          const cover = img(item);
          const href = item.familySlug ? `/catalogo/familia/${item.familySlug}/` : `/catalogo/${item.slug}/`;
          const wa = waLink(item);

          return (
            <article class="card">
              <a class="card__link" href={href} aria-label={`Ver ${item.title}`}>
                <div class="card__img-wrap">
                  {cover
                    ? <img src={cover} alt={item.title} loading="lazy" />
                    : <div class="card__img-placeholder" aria-hidden="true"></div>
                  }
                </div>

                <div class="card__meta">
                  <h2 class="card__title">{item.title}</h2>

                  {(item.familyCount ?? 0) > 1 && (
                    <p class="card__family-badge">{item.familyCount} medidas disponibles →</p>
                  )}

                  {item.excerpt
                    ? <p class="card__excerpt">{item.excerpt}</p>
                    : null
                  }

                  {!catalogOnlyMode && item.familySlug && (item.price != null ? (
                    <p class="card__price">{formatMXN(toMXN(item.price, item))}</p>
                  ) : item.priceLabel ? (
                    <p class="card__price">{item.priceLabel}</p>
                  ) : null)}
                </div>
              </a>

              <div class="card__actions">
                {item.familySlug ? (
                  <a class="btn-family" href={href}>Elige la medida →</a>
                ) : !catalogOnlyMode && (
                  <div class="card__buy">
                    {/* Fila unidad */}
                    <div class="card__buy-row">
                      <div class="card__stepper">
                        <button type="button" class="step-btn" data-step="-1" data-target="unit">−</button>
                        <input class="step-qty" data-qty="unit" type="number" value="0" min="0" readonly />
                        <button type="button" class="step-btn" data-step="1" data-target="unit">+</button>
                      </div>
                      <span class="card__row-price">
                        {item.price != null ? formatMXN(toMXN(item.price, item)) : item.priceLabel || "Cotización"} c/u
                      </span>
                    </div>

                    {/* Fila caja */}
                    {(() => {
                      const bo = item.boxOption;
                      const boxP = (bo?.enabled && bo.unitsPerBox && item.price != null)
                        ? toBoxMXN(item.price, bo.unitsPerBox, item)
                        : null;
                      return bo?.enabled && boxP != null ? (
                        <div class="card__buy-row">
                          <div class="card__stepper">
                            <button type="button" class="step-btn" data-step="-1" data-target="box">−</button>
                            <input class="step-qty" data-qty="box" type="number" value="0" min="0" readonly />
                            <button type="button" class="step-btn" data-step="1" data-target="box">+</button>
                          </div>
                          <div class="card__row-price">
                            <span>{formatMXN(boxP)}</span>
                            <small>{bo.boxLabel || `caja ×${bo.unitsPerBox}`} · {formatMXN(boxP / bo.unitsPerBox!)} c/u</small>
                          </div>
                        </div>
                      ) : null;
                    })()}

                    <button
                      class="btn-cart"
                      type="button"
                      data-add
                      data-title={item.title}
                      data-slug={item.slug}
                      data-url={href}
                      data-price={item.price != null ? toMXN(item.price, item) : 0}
                      data-box-price={item.boxOption?.enabled && item.boxOption.unitsPerBox && item.price != null
                        ? toBoxMXN(item.price, item.boxOption.unitsPerBox, item)
                        : 0}
                      data-box-label={item.boxOption?.boxLabel || `caja ×${item.boxOption?.unitsPerBox ?? ""}`}
                      data-image={cover ?? ""}
                      aria-pressed="false"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                      </svg>
                      Agregar
                    </button>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="empty-state">
        <p>No se encontraron productos.</p>
        <a href="/catalogo/">Ver todos los productos</a>
      </div>
    )}

    <!-- Paginación -->
    {totalPages > 1 && (
      <nav class="pagination" aria-label="Páginas del catálogo">
        {page > 1 && (
          <a href={pageUrl(page - 1)} class="pg-btn pg-prev" aria-label="Página anterior">‹</a>
        )}

        {pgRange.map((p) =>
          p === "…"
            ? <span class="pg-ellipsis">…</span>
            : <a
                href={pageUrl(p as number)}
                class={`pg-btn${page === p ? " is-active" : ""}`}
                aria-current={page === p ? "page" : undefined}
              >{p}</a>
        )}

        {page < totalPages && (
          <a href={pageUrl(page + 1)} class="pg-btn pg-next" aria-label="Página siguiente">›</a>
        )}
      </nav>
    )}
  </main>

  <style>
    /* ── Header ── */
    .catalog-header {
      background: #fff;
      border-bottom: 1px solid rgba(0,0,0,.07);
      padding-top: calc(var(--header-h, 72px) + 36px);
      padding-bottom: 24px;
    }
    .catalog-header__top {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 16px;
    }
    .catalog-title {
      margin: 0 0 2px;
      font-size: 26px;
      font-weight: 900;
      color: #111;
    }
    .catalog-subtitle {
      margin: 0;
      font-size: 13px;
      color: #6b7280;
    }

    /* ── Search ── */
    .search-form {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .search-wrap {
      position: relative;
      flex: 1;
    }
    .search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #9ca3af;
      pointer-events: none;
    }
    .search-input {
      width: 100%;
      padding: 11px 36px 11px 40px;
      border: 1px solid #e5e7eb;
      border-radius: 0;
      font-size: 14px;
      background: #f9fafb;
      color: #111;
      outline: none;
      transition: border-color .15s, background .15s;
      box-sizing: border-box;
    }
    .search-input:focus {
      border-color: #111827;
      background: #fff;
    }
    .search-clear {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      color: #9ca3af;
      font-size: 13px;
      text-decoration: none;
      line-height: 1;
    }
    .search-clear:hover { color: #111; }
    .search-btn {
      padding: 11px 20px;
      background: #111827;
      color: #fff;
      border: 0;
      border-radius: 0;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: background .15s;
    }
    .search-btn:hover { background: #1f2937; }

    /* ── Main ── */
    .catalog-main { padding: 24px 0 70px; }

    .search-results-label {
      margin: 0 0 18px;
      font-size: 13px;
      color: #6b7280;
    }
    .search-results-label a {
      color: #111;
      font-weight: 700;
      text-decoration: underline;
    }

    /* ── Grid ── */
    .grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    /* ── Card ── */
    .card {
      background: #fff;
      border: 1px solid rgba(0,0,0,.07);
      overflow: hidden;
      transition: box-shadow .2s, transform .2s;
      display: flex;
      flex-direction: column;
    }
    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 28px rgba(0,0,0,.09);
    }
    .card__link {
      display: block;
      text-decoration: none;
      color: inherit;
      flex: 1;
    }
    .card__img-wrap {
      overflow: hidden;
      background: #f3f4f6;
      aspect-ratio: 1 / 1;
    }
    .card__img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
      transition: transform .3s ease;
    }
    .card:hover .card__img-wrap img {
      transform: scale(1.03);
    }
    .card__img-placeholder {
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
    }
    .card__meta { padding: 14px 14px 10px; }
    .card__title {
      margin: 0;
      font-size: 14px;
      font-weight: 700;
      color: #111827;
      line-height: 1.3;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card__excerpt {
      margin: 6px 0 0;
      font-size: 12px;
      color: #6b7280;
      line-height: 1.45;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card__family-badge {
      display: inline-block;
      margin: 6px 0 0;
      padding: 3px 8px;
      background: rgba(66,117,255,.1);
      color: #4275ff;
      font-size: 11px;
      font-weight: 700;
      border-radius: 4px;
    }
    .card__price {
      margin: 10px 0 0;
      font-weight: 900;
      font-size: 16px;
      color: #b90404;
    }
    .card__price.is-muted {
      color: #6b7280;
      font-weight: 700;
      font-size: 13px;
    }

    /* ── Card buy / steppers ── */
    .card__buy { display: flex; flex-direction: column; gap: 6px; width: 100%; }
    .card__buy-row { display: flex; align-items: center; gap: 8px; }
    .card__stepper {
      display: flex; align-items: center;
      border: 1px solid #d1d5db; background: #fff; flex-shrink: 0;
    }
    .step-btn {
      width: 28px; height: 30px; border: none; background: none;
      font-size: 16px; cursor: pointer; color: #374151;
      display: flex; align-items: center; justify-content: center;
    }
    .step-btn:hover { background: #f3f4f6; }
    .step-qty {
      width: 36px; height: 30px; border: none;
      border-left: 1px solid #e5e7eb; border-right: 1px solid #e5e7eb;
      text-align: center; font-size: 13px; font-weight: 700;
      -moz-appearance: textfield; background: #fff;
    }
    .step-qty::-webkit-outer-spin-button,
    .step-qty::-webkit-inner-spin-button { -webkit-appearance: none; }
    .card__row-price {
      font-size: 12px; color: #374151; line-height: 1.3;
      display: flex; flex-direction: column;
    }
    .card__row-price span { font-weight: 700; color: #b90404; }
    .card__row-price small { font-size: 11px; color: #6b7280; }

    /* ── Card actions ── */
    .card__actions {
      display: flex;
      gap: 8px;
      padding: 0 12px 14px;
      margin-top: auto;
    }
    .btn-wa {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex: 1;
      justify-content: center;
      padding: 10px 12px;
      background: #25d366;
      color: #fff;
      border: 0;
      border-radius: 0;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: background .15s, transform .15s;
      white-space: nowrap;
    }
    .btn-wa:hover {
      background: #1ebe5d;
      transform: translateY(-1px);
    }
    .btn-cart {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 10px 12px;
      background: transparent;
      color: #111827;
      border: 1.5px solid #d1d5db;
      border-radius: 0;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: border-color .15s, background .15s, transform .15s;
      white-space: nowrap;
    }
    .btn-cart:hover {
      background: #111827;
      color: #fff;
      border-color: #111827;
      transform: translateY(-1px);
    }
    .btn-cart.is-added {
      background: #f0fdf4;
      color: #16a34a;
      border-color: #bbf7d0;
    }
    .btn-family {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 10px 12px;
      background: #111827;
      color: #fff;
      border: 0;
      border-radius: 0;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      transition: background .15s, transform .15s;
      white-space: nowrap;
    }
    .btn-family:hover { background: #374151; transform: translateY(-1px); }

    /* ── Pagination ── */
    .pagination {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-top: 48px;
      flex-wrap: wrap;
    }
    .pg-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border: 1.5px solid #e5e7eb;
      background: #fff;
      color: #374151;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: border-color .15s, background .15s, color .15s;
    }
    .pg-btn:hover {
      border-color: #111827;
      color: #111827;
    }
    .pg-btn.is-active {
      background: #111827;
      border-color: #111827;
      color: #fff;
    }
    .pg-prev, .pg-next {
      font-size: 18px;
      font-weight: 400;
    }
    .pg-ellipsis {
      color: #9ca3af;
      font-size: 14px;
      width: 24px;
      text-align: center;
    }

    /* ── Empty ── */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #6b7280;
    }
    .empty-state a {
      display: inline-block;
      margin-top: 12px;
      color: #111;
      font-weight: 700;
      text-decoration: underline;
    }

    /* ── Responsive ── */
    @media (max-width: 1200px) {
      .grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 900px) {
      /* header es relative en mobile → no necesita padding-top para esquivarlo */
      .catalog-header { padding-top: 28px; }
    }
    @media (max-width: 860px) {
      .grid { grid-template-columns: repeat(2, 1fr); }
      .search-form { flex-direction: column; align-items: stretch; }
      .search-wrap { width: 100%; }
    }
    @media (max-width: 480px) {
      .grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }

      .card__meta { padding: 8px 10px 6px; }
      .card__title { font-size: 12px; }
      .card__price { font-size: 13px; }
      .card__excerpt { display: none; }

      .card__actions {
        flex-direction: column;
        gap: 6px;
        padding: 0 10px 10px;
      }
      .btn-wa, .btn-cart, .btn-family {
        font-size: 11px;
        padding: 7px 8px;
        gap: 4px;
      }
      .btn-wa svg, .btn-cart svg { width: 12px; height: 12px; }
    }
  </style>

  <script is:inline>
    (() => {
      const KEY = "ranking_cart_v1";
      const getCart = () => { try { return JSON.parse(localStorage.getItem(KEY) || "[]"); } catch { return []; } };
      const inCart = (slug) => getCart().some((x) => x?.slug === slug);

      const setBtnState = (btn, added) => {
        if (!btn) return;
        if (added) {
          btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Agregado`;
          btn.classList.add("is-added");
          btn.setAttribute("aria-pressed", "true");
        } else {
          btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg> Agregar`;
          btn.classList.remove("is-added");
          btn.setAttribute("aria-pressed", "false");
        }
      };

      const paintAll = () => {
        document.querySelectorAll("[data-add]").forEach((b) => {
          setBtnState(b, inCart(b.getAttribute("data-slug") || ""));
        });
      };

      // Steppers
      document.addEventListener("click", (e) => {
        const stepBtn = e.target?.closest?.("[data-step]");
        if (!stepBtn) return;
        const card = stepBtn.closest("article");
        if (!card) return;
        const target = stepBtn.getAttribute("data-target");
        const input = card.querySelector(`[data-qty="${target}"]`);
        if (!input) return;
        input.value = Math.max(0, (Number(input.value) || 0) + Number(stepBtn.getAttribute("data-step")));
      });

      // Agregar al carrito
      document.addEventListener("click", (e) => {
        const btn = e.target?.closest?.("[data-add]");
        if (!btn) return;
        const slug  = btn.getAttribute("data-slug") || "";
        if (!slug) return;
        const title = btn.getAttribute("data-title") || "";
        const url   = btn.getAttribute("data-url")   || "";
        const image = btn.getAttribute("data-image") || "";
        const price = Number(btn.getAttribute("data-price") || 0);
        const boxPrice = Number(btn.getAttribute("data-box-price") || 0);
        const boxLabel = btn.getAttribute("data-box-label") || "";

        const card = btn.closest("article");
        const qtyUnit = card ? Number(card.querySelector('[data-qty="unit"]')?.value || 0) : 1;
        const qtyBox  = card ? Number(card.querySelector('[data-qty="box"]')?.value  || 0) : 0;

        const addedSomething = qtyUnit > 0 || qtyBox > 0;
        if (qtyUnit > 0) window.Cart?.addItem({ title, slug, url, image, price, qty: qtyUnit });
        if (qtyBox > 0 && boxPrice > 0) window.Cart?.addItem({
          title: `${title} — ${boxLabel}`,
          slug: `${slug}--caja`,
          url, image, price: boxPrice, qty: qtyBox, variantLabel: boxLabel,
        });
        // Si no pusieron cantidad, agrega 1 unidad por defecto
        if (!addedSomething) window.Cart?.addItem({ title, slug, url, image, price, qty: 1 });

        // Reset steppers
        card?.querySelectorAll(".step-qty").forEach(i => (i.value = "0"));
        setBtnState(btn, true);
      });

      window.addEventListener("cart:updated", paintAll);
      paintAll();
    })();
  </script>
</BaseLayout>
