---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { client as sanityClient } from "../../../lib/sanity/client";
import { SITE_SETTINGS_QUERY } from "../../../lib/sanity/queries";
import { urlFor } from "../../../lib/sanity/image";
import groq from "groq";

type FamilyItem = {
  _id: string;
  title: string;
  slug: string;
  sku?: string;
  excerpt?: string;
  coverImage?: any;
  imageUrl?: string;
  price?: number;
  variantPrice?: number;
  priceLabel?: string;
  isFamilyRepresentative?: boolean;
  whatsapp?: { enabled?: boolean; phone?: string; message?: string };
  boxOption?: { enabled?: boolean; unitsPerBox?: number; boxMarkupPercent?: number; boxLabel?: string };
};

const { slug: familySlug } = Astro.params;

const [items, settings] = await Promise.all([
  sanityClient.fetch<FamilyItem[]>(
    groq`*[_type=="catalogItem" && familySlug==$familySlug && published!=false] | order(isFamilyRepresentative desc, title asc) {
      _id, title, "slug": slug.current, sku, excerpt,
      coverImage, imageUrl, price, priceLabel, isFamilyRepresentative,
      "variantPrice": variants[0].price,
      boxOption{ enabled, unitsPerBox, boxMarkupPercent, boxLabel },
      whatsapp{ enabled, phone, message }
    }`,
    { familySlug }
  ),
  sanityClient.fetch(SITE_SETTINGS_QUERY),
]);

if (!items?.length) return Astro.redirect("/catalogo/", 302);

// Title from representative or first
const representative = items.find((i) => i.isFamilyRepresentative) ?? items[0];
const familyTitle = representative.title
  .replace(/\s+\d[\d/'".,\s]*$/, "")   // quita la medida al final si la hay
  .trim();

const shopCurrency: string = settings?.shopCurrency ?? "USD";
const usdRate: number      = settings?.usdRate      ?? 17;
const markupFactor         = 1 + (settings?.markupPercent ?? 26.5) / 100;
const toMXN    = (n: number) => (shopCurrency === "USD" ? n * usdRate : n) * markupFactor;
const toBoxMXN = (unitPrice: number, units: number, markup: number) =>
  (shopCurrency === "USD" ? unitPrice * usdRate : unitPrice) * units * (1 + markup / 100);
const formatMXN = (n: number) => `$${n.toLocaleString("es-MX")} MXN`;

const img = (item: FamilyItem): string | null => {
  if (item.coverImage?.asset) return urlFor(item.coverImage).width(600).quality(80).auto("format").url();
  return item.imageUrl ?? null;
};
---

<BaseLayout
  title={`${familyTitle} | La Bodega del Instalador`}
  description={`${items.length} medidas disponibles de ${familyTitle}`}
  canonical={`https://www.labodegadelinstalador.net/catalogo/familia/${familySlug}/`}
  bodyClass="is-shop"
>
  <div class="fam-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <a href="/catalogo/">Tienda</a>
        <span aria-hidden="true">›</span>
        <span>{familyTitle}</span>
      </nav>

      <h1 class="fam-title">{familyTitle}</h1>
      <p class="fam-sub">{items.length} medidas / presentaciones disponibles</p>
    </div>
  </div>

  <main class="container fam-main">
    <div class="fam-grid">
      {items.map((item) => {
        const cover = img(item);
        const href  = `/catalogo/${item.slug}/`;

        return (
          <article class={`fam-card${item.isFamilyRepresentative ? " fam-card--principal" : ""}`}>
            <a class="fam-card__link" href={href}>
              <div class="fam-card__img">
                {cover
                  ? <img src={cover} alt={item.title} loading="lazy" />
                  : <div class="fam-card__img-ph" aria-hidden="true"></div>
                }
              </div>

              <div class="fam-card__info">
                <h2 class="fam-card__title">{item.title}</h2>
                {item.sku && <p class="fam-card__sku">SKU: {item.sku}</p>}
                {item.excerpt && <p class="fam-card__excerpt">{item.excerpt}</p>}
              </div>
            </a>

            <div class="fam-card__actions">
              <div class="card__buy">
                <div class="card__buy-row">
                  <div class="card__stepper">
                    <button type="button" class="step-btn" data-step="-1" data-target="unit">−</button>
                    <input class="step-qty" data-qty="unit" type="number" value="0" min="0" readonly />
                    <button type="button" class="step-btn" data-step="1" data-target="unit">+</button>
                  </div>
                  <span class="card__row-price">
                    {(item.price ?? item.variantPrice) != null
                      ? formatMXN(toMXN((item.price ?? item.variantPrice)!))
                      : item.priceLabel || "Cotización"} c/u
                  </span>
                </div>

                {(() => {
                  const bo = item.boxOption;
                  const unitP = item.price ?? item.variantPrice ?? null;
                  const boxP = (bo?.enabled && bo.unitsPerBox && unitP != null)
                    ? toBoxMXN(unitP, bo.unitsPerBox, bo.boxMarkupPercent ?? 0)
                    : null;
                  return bo?.enabled && boxP != null ? (
                    <div class="card__buy-row">
                      <div class="card__stepper">
                        <button type="button" class="step-btn" data-step="-1" data-target="box">−</button>
                        <input class="step-qty" data-qty="box" type="number" value="0" min="0" readonly />
                        <button type="button" class="step-btn" data-step="1" data-target="box">+</button>
                      </div>
                      <div class="card__row-price">
                        <span>{formatMXN(boxP)}</span>
                        <small>{bo.boxLabel || `caja ×${bo.unitsPerBox}`}</small>
                      </div>
                    </div>
                  ) : null;
                })()}

                <button
                  class="btn-cart"
                  type="button"
                  data-add
                  data-title={item.title}
                  data-slug={item.slug}
                  data-url={href}
                  data-price={(item.price ?? item.variantPrice) != null ? toMXN((item.price ?? item.variantPrice)!) : 0}
                  data-box-price={(() => {
                    const bo = item.boxOption;
                    const unitP = item.price ?? item.variantPrice ?? null;
                    return (bo?.enabled && bo.unitsPerBox && unitP != null)
                      ? toBoxMXN(unitP, bo.unitsPerBox, bo.boxMarkupPercent ?? 0)
                      : 0;
                  })()}
                  data-box-label={item.boxOption?.boxLabel || `caja ×${item.boxOption?.unitsPerBox ?? ""}`}
                  data-image={cover ?? ""}
                  aria-pressed="false"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                  </svg>
                  Agregar
                </button>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <div class="fam-back">
      <a href="/catalogo/">← Volver al catálogo</a>
    </div>
  </main>

  <style>
    .fam-header {
      background: #f8fafc;
      border-bottom: 1px solid rgba(0,0,0,.08);
      padding: calc(var(--header-h, 80px) + 32px) 0 28px;
    }
    .breadcrumb {
      display: flex; align-items: center; gap: 6px;
      font-size: 12px; opacity: .6; margin-bottom: 10px;
    }
    .breadcrumb a { color: inherit; text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }
    .fam-title { font-size: clamp(22px, 3vw, 36px); letter-spacing: -.02em; margin: 0 0 6px; }
    .fam-sub   { margin: 0; opacity: .6; font-size: 14px; }

    .fam-main  { padding: 36px 0 80px; }

    .fam-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 20px;
    }

    .fam-card {
      background: #fff;
      border: 1px solid rgba(0,0,0,.1);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: box-shadow .15s;
    }
    .fam-card:hover { box-shadow: 0 6px 24px rgba(0,0,0,.10); }
    .fam-card--principal { border-color: #4275ff; }

    .fam-card__link { display: block; text-decoration: none; color: inherit; flex: 1; }

    .fam-card__img {
      aspect-ratio: 1/1;
      background: #f3f4f6;
      overflow: hidden;
    }
    .fam-card__img img    { width: 100%; height: 100%; object-fit: contain; display: block; }
    .fam-card__img-ph     { width: 100%; height: 100%; }

    .fam-card__info  { padding: 14px 16px; }
    .fam-card__title { font-size: 14px; font-weight: 700; margin: 0 0 4px; line-height: 1.3; }
    .fam-card__sku   { font-size: 11px; font-family: monospace; color: #6b7280; margin: 0 0 4px; }
    .fam-card__excerpt { font-size: 12px; opacity: .6; margin: 0 0 8px; line-height: 1.5;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .fam-card__price { font-size: 15px; font-weight: 900; color: #b90404; margin: 8px 0 0; }
    .fam-card__box-badge {
      display: inline-block;
      margin-top: 5px;
      font-size: 11px;
      background: #fff7ed;
      border: 1px solid #fdba74;
      color: #c2410c;
      padding: 2px 8px;
      border-radius: 4px;
      font-weight: 600;
    }

    .fam-card__actions {
      padding: 10px 16px 14px;
      border-top: 1px solid rgba(0,0,0,.06);
    }

    .card__buy { display: flex; flex-direction: column; gap: 6px; }
    .card__buy-row {
      display: flex; align-items: center; gap: 8px;
    }
    .card__stepper {
      display: inline-flex; align-items: center;
      border: 1.5px solid #d1d5db; overflow: hidden;
    }
    .step-btn {
      width: 28px; height: 28px; background: #f3f4f6; border: none;
      font-size: 16px; line-height: 1; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .step-btn:hover { background: #e5e7eb; }
    .step-qty {
      width: 36px; height: 28px; border: none; border-left: 1.5px solid #d1d5db;
      border-right: 1.5px solid #d1d5db; text-align: center;
      font-size: 13px; font-weight: 600; background: #fff; color: #111;
    }
    .card__row-price {
      font-size: 12px; font-weight: 700; color: #b90404; flex: 1;
      display: flex; flex-direction: column; line-height: 1.3;
    }
    .card__row-price small { font-size: 10px; font-weight: 500; color: #6b7280; }

    .btn-cart {
      display: inline-flex; align-items: center; justify-content: center; gap: 5px;
      padding: 8px 12px; background: transparent; color: #111827;
      border: 1.5px solid #d1d5db; border-radius: 0;
      font-size: 12px; font-weight: 700; cursor: pointer;
      transition: border-color .15s, background .15s; flex: 1;
    }
    .btn-cart:hover { background: #111827; color: #fff; border-color: #111827; }
    .btn-cart.is-added { background: #f0fdf4; color: #16a34a; border-color: #bbf7d0; }

    .fam-back { margin-top: 40px; }
    .fam-back a { opacity: .6; font-size: 13px; text-decoration: none; }
    .fam-back a:hover { opacity: 1; }

    @media (max-width: 900px) {
      .fam-header { padding-top: 28px; }
    }
    @media (max-width: 600px) {
      .fam-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }

      .fam-card__info  { padding: 8px 10px; }
      .fam-card__title { font-size: 12px; }
      .fam-card__price { font-size: 13px; }

      .fam-card__actions { padding: 8px 10px 10px; }
      .step-btn  { width: 24px; height: 26px; font-size: 14px; }
      .step-qty  { width: 30px; height: 26px; font-size: 12px; }
      .card__row-price { font-size: 11px; }
      .btn-cart {
        font-size: 11px;
        padding: 7px 8px;
        gap: 4px;
      }
      .btn-cart svg { width: 12px; height: 12px; }
    }
  </style>

  <script is:inline>
    (() => {
      const KEY = "ranking_cart_v1";
      const getCart = () => { try { return JSON.parse(localStorage.getItem(KEY) || "[]"); } catch { return []; } };
      const inCart = (slug) => getCart().some((x) => x?.slug === slug);

      const setBtnState = (btn, added) => {
        if (!btn) return;
        if (added) {
          btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Agregado`;
          btn.classList.add("is-added");
          btn.setAttribute("aria-pressed", "true");
        } else {
          btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg> Agregar`;
          btn.classList.remove("is-added");
          btn.setAttribute("aria-pressed", "false");
        }
      };

      const paintAll = () => {
        document.querySelectorAll("[data-add]").forEach((b) => {
          setBtnState(b, inCart(b.getAttribute("data-slug") || ""));
        });
      };

      document.addEventListener("click", (e) => {
        const stepBtn = e.target?.closest?.("[data-step]");
        if (stepBtn) {
          const card = stepBtn.closest("article");
          if (!card) return;
          const target = stepBtn.getAttribute("data-target");
          const input = card.querySelector(`[data-qty="${target}"]`);
          if (input) input.value = Math.max(0, (Number(input.value) || 0) + Number(stepBtn.getAttribute("data-step")));
          return;
        }

        const btn = e.target?.closest?.("[data-add]");
        if (!btn) return;
        const slug = btn.getAttribute("data-slug") || "";
        if (!slug) return;

        const title    = btn.getAttribute("data-title") || "";
        const url      = btn.getAttribute("data-url") || "";
        const image    = btn.getAttribute("data-image") || "";
        const price    = Number(btn.getAttribute("data-price") || 0);
        const boxPrice = Number(btn.getAttribute("data-box-price") || 0);
        const boxLabel = btn.getAttribute("data-box-label") || "";
        const card     = btn.closest("article");
        const qtyUnit  = card ? Number(card.querySelector('[data-qty="unit"]')?.value || 0) : 1;
        const qtyBox   = card ? Number(card.querySelector('[data-qty="box"]')?.value  || 0) : 0;

        if (qtyUnit > 0) window.Cart?.addItem({ title, slug, url, image, price, qty: qtyUnit });
        if (qtyBox > 0 && boxPrice > 0) window.Cart?.addItem({
          title: `${title} — ${boxLabel}`,
          slug: `${slug}--caja`,
          url, image, price: boxPrice, qty: qtyBox, variantLabel: boxLabel,
        });
        if (!qtyUnit && !qtyBox) window.Cart?.addItem({ title, slug, url, image, price, qty: 1 });

        card?.querySelectorAll(".step-qty").forEach(i => (i.value = "0"));
        setBtnState(btn, true);
      });

      window.addEventListener("cart:updated", paintAll);
      paintAll();
    })();
  </script>
</BaseLayout>
