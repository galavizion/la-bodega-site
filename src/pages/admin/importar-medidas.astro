---
import AdminNav from "../../components/AdminNav.astro";

export const prerender = false;

// Protección: si ADMIN_KEY está definida, requiere ?key=VALOR en la URL
const adminKey = import.meta.env.ADMIN_KEY;
if (adminKey && Astro.url.searchParams.get("key") !== adminKey) {
  return Astro.redirect("/");
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Importar medidas y peso</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      font-family: system-ui, sans-serif;
      background: #0f172a;
      color: #e2e8f0;
      margin: 0;
      min-height: 100vh;
      padding: 40px 20px;
    }
    .wrap { max-width: 860px; margin: 0 auto; }
    h1 { font-size: 24px; margin: 0 0 8px; }
    .sub { opacity: .6; margin: 0 0 32px; font-size: 14px; }

    .card {
      background: rgba(255,255,255,.05);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 16px;
      padding: 28px;
      margin-bottom: 24px;
    }
    h2 { font-size: 16px; margin: 0 0 16px; }

    label { display: block; font-size: 13px; opacity: .7; margin-bottom: 6px; }

    input[type="file"] {
      display: block;
      width: 100%;
      padding: 12px;
      border-radius: 10px;
      border: 2px dashed rgba(255,255,255,.2);
      background: rgba(255,255,255,.04);
      color: inherit;
      cursor: pointer;
      font-size: 14px;
      margin-bottom: 16px;
    }
    input[type="file"]:hover { border-color: rgba(255,255,255,.4); }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 20px;
      border-radius: 10px;
      border: none;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: opacity .2s;
    }
    .btn:disabled { opacity: .4; cursor: not-allowed; }
    .btn-primary { background: #4275ff; color: #fff; }
    .btn-primary:hover:not(:disabled) { opacity: .88; }

    #preview {
      margin-top: 20px;
      display: none;
    }
    #preview table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    #preview th, #preview td {
      text-align: left;
      padding: 8px 10px;
      border-bottom: 1px solid rgba(255,255,255,.08);
    }
    #preview th { opacity: .5; font-weight: 600; text-transform: uppercase; font-size: 11px; }

    #log {
      margin-top: 20px;
      font-size: 13px;
      display: none;
    }
    .log-item { padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,.06); }
    .log-ok { color: #4ade80; }
    .log-err { color: #f87171; }
    .log-skip { color: #facc15; }

    .progress-bar {
      height: 6px;
      background: rgba(255,255,255,.1);
      border-radius: 99px;
      overflow: hidden;
      margin-bottom: 12px;
      display: none;
    }
    .progress-bar__fill {
      height: 100%;
      background: #4275ff;
      width: 0%;
      transition: width .3s;
    }

    .cols-info {
      font-size: 12px;
      opacity: .55;
      line-height: 1.7;
    }
    code { background: rgba(255,255,255,.08); padding: 1px 5px; border-radius: 4px; }
  </style>
</head>
<body>
  <div class="wrap">
    <AdminNav active="importar-medidas" />
    <h1>📏 Importar medidas y peso</h1>
    <p class="sub">
      Carga un Excel/CSV que solo traiga SKU + medidas. Este importador <strong>no toca</strong>
      nombre, precio, imágenes ni ningún otro campo — solo actualiza Length, Width, Height y Weight.
    </p>

    <div class="card">
      <h2>Columnas esperadas</h2>
      <p class="cols-info">
        <strong>Requerida:</strong> <code>sku</code> (busca primero en variantes; si no coincide, usa el SKU principal del producto)
        <br/><br/>
        <strong>Medida del producto/variante (al menos una):</strong><br/>
        <code>length</code> / <code>largo</code> (cm) · <code>width</code> / <code>ancho</code> (cm) ·
        <code>height</code> / <code>alto</code> (cm) · <code>weight</code> / <code>peso</code> (kg)
        <br/><br/>
        <strong>Medida de la caja (opcional):</strong><br/>
        <code>box_length</code> / <code>largo_caja</code> · <code>box_width</code> / <code>ancho_caja</code> ·
        <code>box_height</code> / <code>alto_caja</code> · <code>box_weight</code> / <code>peso_caja</code>
      </p>
    </div>

    <div class="card">
      <h2>Cargar archivo</h2>
      <label for="fileInput">Selecciona tu archivo (.xlsx, .xls, .csv)</label>
      <input type="file" id="fileInput" accept=".xlsx,.xls,.csv" />

      <div id="preview"></div>

      <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
        <button class="btn btn-primary" id="importBtn" disabled>
          ⬆️ Actualizar medidas
        </button>
        <button class="btn" id="clearLogBtn" style="background:rgba(255,255,255,.08);color:inherit" onclick="localStorage.removeItem('importar_medidas_log');document.getElementById('log').innerHTML='';document.getElementById('log').style.display='none'">
          🗑 Limpiar log
        </button>
      </div>

      <div class="progress-bar" id="progressBar">
        <div class="progress-bar__fill" id="progressFill"></div>
      </div>

      <div id="log"></div>
    </div>
  </div>

  <script is:inline src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
  <script is:inline>
    const fileInput = document.getElementById("fileInput");
    const importBtn = document.getElementById("importBtn");
    const previewEl = document.getElementById("preview");
    const logEl = document.getElementById("log");
    const progressBar = document.getElementById("progressBar");
    const progressFill = document.getElementById("progressFill");

    const LOG_KEY = "importar_medidas_log";
    let parsedRows = [];

    (function restoreLog() {
      const saved = localStorage.getItem(LOG_KEY);
      if (!saved) return;
      const entries = JSON.parse(saved);
      if (!entries.length) return;
      logEl.style.display = "block";
      entries.forEach(({ type, msg }) => _renderLogItem(type, msg));
    })();

    function fixEncoding(str) {
      if (typeof str !== "string" || !str) return str;
      try { return decodeURIComponent(escape(str)); } catch { return str; }
    }

    function fixRowEncoding(row) {
      const fixed = {};
      for (const [k, v] of Object.entries(row)) {
        fixed[k] = typeof v === "string" ? fixEncoding(v) : v;
      }
      return fixed;
    }

    fileInput.addEventListener("change", async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const buffer = await file.arrayBuffer();
      const wb = XLSX.read(buffer, { type: "array" });
      const sheetName = wb.SheetNames[0];
      const ws = wb.Sheets[sheetName];
      const rows = XLSX.utils.sheet_to_json(ws, { defval: "" }).map(fixRowEncoding);

      parsedRows = rows;
      renderPreview(rows.slice(0, 5), sheetName);
      importBtn.disabled = rows.length === 0;
    });

    function renderPreview(rows, sheetName) {
      if (!rows.length) return;
      const keys = Object.keys(rows[0]);
      const thead = `<tr>${keys.map(k => `<th>${k}</th>`).join("")}</tr>`;
      const tbody = rows.map(r =>
        `<tr>${keys.map(k => `<td>${r[k]}</td>`).join("")}</tr>`
      ).join("");

      previewEl.style.display = "block";
      previewEl.innerHTML = `
        <p style="font-size:13px;opacity:.6;margin:0 0 10px">Hoja: <strong>${sheetName}</strong> · ${parsedRows.length} filas detectadas — mostrando primeras ${rows.length}</p>
        <div style="overflow-x:auto"><table><thead>${thead}</thead><tbody>${tbody}</tbody></table></div>
      `;
    }

    importBtn.addEventListener("click", async () => {
      if (!parsedRows.length) return;

      importBtn.disabled = true;
      logEl.style.display = "block";
      logEl.innerHTML = "";
      progressBar.style.display = "block";
      localStorage.removeItem(LOG_KEY);

      let ok = 0, err = 0;
      const timestamp = new Date().toLocaleString("es-MX");
      addLog("skip", `⏱ Importación de medidas iniciada — ${timestamp} — ${parsedRows.length} filas`);

      for (let i = 0; i < parsedRows.length; i++) {
        const row = parsedRows[i];
        const pct = Math.round(((i + 1) / parsedRows.length) * 100);
        progressFill.style.width = pct + "%";

        const label = row.sku || row.SKU || `Fila ${i+1}`;

        try {
          const res = await fetch("/api/import-dimensions", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(row),
          });
          const data = await res.json();

          if (res.ok) {
            ok++;
            addLog("ok", `✅ ${label} — ${data.action ?? "actualizado"}`);
          } else {
            err++;
            addLog("err", `❌ ${label} — ${data.error ?? "error"}`);
          }
        } catch (e) {
          err++;
          addLog("err", `❌ ${label} — Error de red`);
        }
      }

      addLog("skip", `─── Listo: ${ok} actualizados · ${err} errores ───`);
      importBtn.disabled = false;
    });

    function addLog(type, msg) {
      _renderLogItem(type, msg);
      const saved = JSON.parse(localStorage.getItem(LOG_KEY) || "[]");
      saved.push({ type, msg });
      localStorage.setItem(LOG_KEY, JSON.stringify(saved));
    }

    function _renderLogItem(type, msg) {
      const div = document.createElement("div");
      div.className = `log-item log-${type}`;
      div.textContent = msg;
      logEl.appendChild(div);
      logEl.scrollTop = logEl.scrollHeight;
    }
  </script>
</body>
</html>
