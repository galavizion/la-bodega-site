---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sanity, urlFor } from "../../lib/sanity";
import { toHTML } from "@portabletext/to-html";

export const prerender = false;

type Post = {
  title: string;
  excerpt?: string;
  publishedAt?: string;
  _updatedAt?: string;
  mainImage?: any;
  body?: any[];
  faqs?: { q?: string; a?: string }[];
  categories?: { title?: string; slug?: string }[];
  author?: { name?: string; slug?: { current?: string } } | null;
  seo?: {
    title?: string;
    description?: string;
    canonical?: string;
    noindex?: boolean;
    ogImage?: { asset?: { url?: string } };
  };
};

const { slug } = Astro.params;
const post = await sanity.fetch<Post>(
  `*[_type=="post" && slug.current == $slug][0]{
    title, excerpt, publishedAt, _updatedAt, mainImage, body,
    faqs[]{ q, a },
    categories[]->{ title, "slug": slug.current },
    author->{ name, slug },
    seo{ title, description, canonical, noindex, ogImage{ asset->{ url } } }
  }`,
  { slug }
);

const SITE = "https://www.labodegadelinstalador.net";
const title = post?.seo?.title || post?.title || "Artículo";
const description = post?.seo?.description || post?.excerpt || "Guía de La Bodega del Instalador.";
const canonical = post?.seo?.canonical || `${SITE}/blog/${slug}/`;

const dateISO = post?.publishedAt ? new Date(post.publishedAt).toISOString() : "";
const datePretty = post?.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString("es-MX", { year: "numeric", month: "long", day: "numeric" })
  : "";
const updatedISO = post?._updatedAt ? new Date(post._updatedAt).toISOString() : "";

const category = post?.categories?.[0]?.title ?? "General";
const keywords = (post?.categories ?? []).map((c) => c?.title).filter(Boolean) as string[];

const readingTime = (() => {
  const body = post?.body;
  if (!Array.isArray(body)) return null;
  const text = body
    .filter((b) => b?._type === "block" && Array.isArray(b.children))
    .map((b) => b.children.map((c: any) => c.text || "").join(" "))
    .join(" ");
  const words = text.trim() ? text.trim().split(/\s+/).length : 0;
  return Math.max(2, Math.round(words / 180));
})();

const cover = post?.mainImage ? urlFor(post.mainImage).width(1400).height(740).fit("crop").url() : null;

const html = post?.body
  ? toHTML(post.body, {
      components: {
        types: {
          image: ({ value }: any) => {
            const src = urlFor(value).width(1200).url();
            const alt = value?.alt || title || "Imagen";
            return `<figure class="post-img"><img src="${src}" alt="${alt}" loading="lazy" /></figure>`;
          },
        },
        marks: {
          link: ({ children, value }: any) => {
            const href = value?.href || "#";
            const external = href.startsWith("http");
            return `<a href="${href}" ${external ? 'target="_blank" rel="noreferrer noopener"' : ""}>${children}</a>`;
          },
        },
      },
    })
  : "<p>Sin contenido.</p>";

const AUTHOR_NAME = post?.author?.name ?? "La Bodega del Instalador";
const AUTHOR_URL = post?.author?.slug?.current
  ? `${SITE}/autor/${post.author.slug.current}/`
  : SITE;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "Guías y Tips", item: `${SITE}/blog/` },
    { "@type": "ListItem", position: 3, name: title, item: canonical },
  ],
};

const articleSchema: any = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonical}#post`,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  url: canonical,
  headline: title,
  description,
  inLanguage: "es-MX",
  articleSection: category,
  ...(keywords?.length ? { keywords } : {}),
  ...(dateISO ? { datePublished: dateISO } : {}),
  ...(updatedISO ? { dateModified: updatedISO } : {}),
  ...(cover ? { image: [cover] } : {}),
  author: AUTHOR_NAME === "La Bodega del Instalador"
    ? { "@type": "Organization", name: "La Bodega del Instalador", url: SITE }
    : { "@type": "Person", name: AUTHOR_NAME, url: AUTHOR_URL },
  publisher: { "@type": "Organization", name: "La Bodega del Instalador", url: SITE },
  ...(readingTime ? { timeRequired: `PT${readingTime}M` } : {}),
};

const faqSchema = Array.isArray(post?.faqs) && post.faqs.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: post.faqs.filter((f) => f?.q && f?.a).map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;
---

<BaseLayout
  schema={[breadcrumbSchema, articleSchema, ...(faqSchema ? [faqSchema] : [])]}
  title={`${title} | La Bodega del Instalador`}
  description={description}
  canonical={canonical}
>
  <div class="post-wrap">
    <div class="container">

      <!-- Breadcrumb -->
      <nav class="post__crumbs" aria-label="Breadcrumb">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/blog/">Guías y Tips</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{title}</span>
      </nav>

      <div class="post__grid">
        <!-- Columna principal -->
        <article class="post__main">

          <!-- Encabezado del artículo -->
          <header class="post__header">
            <div class="post__meta">
              <span class="post__pill">{category}</span>
              {post?.publishedAt && (
                <>
                  <span class="post__dot" aria-hidden="true">·</span>
                  <time datetime={dateISO}>{datePretty}</time>
                </>
              )}
              {readingTime && (
                <>
                  <span class="post__dot" aria-hidden="true">·</span>
                  <span>{readingTime} min lectura</span>
                </>
              )}
            </div>

            <h1 class="post__h1">{title}</h1>
            {description && <p class="post__desc">{description}</p>}
          </header>

          <!-- Imagen de portada -->
          {cover && (
            <figure class="post__cover">
              <img src={cover} alt={title} loading="eager" />
            </figure>
          )}

          <!-- Contenido principal -->
          <div class="post__content" set:html={html}></div>

          <!-- FAQs (si existen) -->
          {Array.isArray(post?.faqs) && post.faqs.length > 0 && (
            <section class="post__faqs">
              <h2>Preguntas frecuentes</h2>
              {post.faqs.filter(f => f?.q && f?.a).map(f => (
                <details class="faq-item">
                  <summary class="faq-item__q">{f.q}</summary>
                  <p class="faq-item__a">{f.a}</p>
                </details>
              ))}
            </section>
          )}

        </article>

        <!-- Sidebar -->
        <aside class="post__side">
          <div class="side-card">
            <h3>Categorías</h3>
            <div class="side-links">
              <a class="side-link" href="/blog/">Todos los artículos</a>
              <a class="side-link" href="/catalogo/">Ver tienda</a>
              <a class="side-link" href="/catalogo/">Materiales</a>
              <a class="side-link" href="/carrito/">Mi carrito</a>
            </div>
          </div>

          <div class="side-card side-card--tip">
            <p class="side-tip__label">Tip del instalador</p>
            <p>
              Para cotizaciones rápidas escríbenos por WhatsApp con la medida y cantidad que necesitas.
            </p>
          </div>
        </aside>
      </div>

    </div>
  </div>

  <style>
    /* ── Wrap ── */
    .post-wrap {
      background: #fff;
      color: #111;
      padding-top: calc(var(--header-h, 72px) + 200px);
      padding-bottom: 72px;
    }

    /* ── Breadcrumb ── */
    .post__crumbs {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
      font-size: 13px;
      color: #6b7280;
      margin-bottom: 28px;
    }
    .post__crumbs a { color: #6b7280; text-decoration: none; }
    .post__crumbs a:hover { color: #111; text-decoration: underline; }
    .post__crumbs span:last-child { color: #111; font-weight: 600; }

    /* ── Grid ── */
    .post__grid {
      display: grid;
      grid-template-columns: 1fr 280px;
      gap: 32px;
      align-items: start;
    }
    .post__main { min-width: 0; }

    /* ── Header del artículo ── */
    .post__header {
      margin-bottom: 24px;
    }
    .post__meta {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      font-size: 13px;
      color: #6b7280;
      margin-bottom: 14px;
    }
    .post__pill {
      display: inline-flex;
      padding: 4px 10px;
      background: #f3f4f6;
      color: #111;
      font-weight: 700;
      font-size: 11px;
      letter-spacing: .04em;
      text-transform: uppercase;
    }
    .post__dot { opacity: .5; }

    .post__h1 {
      margin: 0 0 12px;
      font-size: clamp(26px, 3vw, 42px);
      font-weight: 900;
      line-height: 1.1;
      color: #111;
      letter-spacing: -.02em;
    }
    .post__desc {
      margin: 0;
      font-size: 16px;
      line-height: 1.6;
      color: #4b5563;
      max-width: 68ch;
    }

    /* ── Cover ── */
    .post__cover { margin: 0 0 28px; }
    .post__cover img {
      width: 100%;
      height: auto;
      display: block;
      border: 1px solid rgba(0,0,0,.08);
    }

    /* ── Contenido ── */
    .post__content {
      font-size: 16px;
      line-height: 1.8;
      color: #1f2937;
    }
    .post__content :global(h2) {
      margin: 36px 0 12px;
      font-size: 22px;
      font-weight: 800;
      line-height: 1.2;
      color: #111;
      border-bottom: 2px solid #f3f4f6;
      padding-bottom: 8px;
    }
    .post__content :global(h3) {
      margin: 28px 0 10px;
      font-size: 18px;
      font-weight: 700;
      line-height: 1.25;
      color: #111;
    }
    .post__content :global(h4) {
      margin: 20px 0 8px;
      font-size: 16px;
      font-weight: 700;
      color: #111;
    }
    .post__content :global(p) { margin: 0 0 16px; }
    .post__content :global(p:last-child) { margin-bottom: 0; }
    .post__content :global(ul), .post__content :global(ol) {
      margin: 0 0 16px;
      padding-left: 22px;
    }
    .post__content :global(li) { margin: 0 0 6px; }
    .post__content :global(a) {
      color: #111;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .post__content :global(a:hover) { opacity: .7; }
    .post__content :global(blockquote) {
      margin: 20px 0;
      padding: 14px 18px;
      border-left: 4px solid #111827;
      background: #f9fafb;
      color: #374151;
      font-style: italic;
    }
    .post__content :global(code) {
      font-family: ui-monospace, "Courier New", monospace;
      font-size: 0.9em;
      background: #f3f4f6;
      color: #111;
      padding: 2px 6px;
      border-radius: 4px;
    }
    .post__content :global(pre) {
      overflow: auto;
      padding: 16px;
      background: #1f2937;
      color: #f9fafb;
      margin: 0 0 16px;
    }
    .post__content :global(pre code) {
      background: none;
      color: inherit;
      padding: 0;
    }
    .post__content :global(.post-img) { margin: 20px 0; }
    .post__content :global(.post-img img) {
      width: 100%; height: auto; display: block;
      border: 1px solid rgba(0,0,0,.08);
    }
    .post__content :global(strong) { color: #111; }

    /* ── FAQs ── */
    .post__faqs {
      margin-top: 40px;
      padding-top: 28px;
      border-top: 2px solid #f3f4f6;
    }
    .post__faqs h2 {
      margin: 0 0 16px;
      font-size: 20px;
      font-weight: 800;
      color: #111;
    }
    .faq-item {
      border-bottom: 1px solid #e5e7eb;
    }
    .faq-item__q {
      padding: 14px 0;
      font-size: 15px;
      font-weight: 700;
      color: #111;
      cursor: pointer;
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .faq-item__q::after {
      content: "+";
      font-size: 18px;
      font-weight: 400;
      color: #9ca3af;
      flex-shrink: 0;
    }
    details[open] .faq-item__q::after { content: "−"; }
    .faq-item__a {
      margin: 0 0 14px;
      font-size: 14px;
      line-height: 1.65;
      color: #4b5563;
    }

    /* ── Sidebar ── */
    .post__side { position: sticky; top: calc(var(--header-h, 72px) + 16px); }

    .side-card {
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      padding: 18px;
      margin-bottom: 16px;
    }
    .side-card h3 {
      margin: 0 0 12px;
      font-size: 14px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: #111;
    }
    .side-card p {
      margin: 0;
      font-size: 13px;
      line-height: 1.6;
      color: #374151;
    }
    .side-card--tip { background: #fffbeb; border-color: #fde68a; }
    .side-tip__label {
      margin: 0 0 6px !important;
      font-size: 11px !important;
      font-weight: 800 !important;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #92400e !important;
    }

    .side-links { display: grid; gap: 6px; }
    .side-link {
      display: block;
      padding: 9px 12px;
      background: #fff;
      border: 1px solid #e5e7eb;
      color: #111;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: border-color .15s, background .15s;
    }
    .side-link:hover { border-color: #111; background: #f9fafb; }

    /* ── Responsive ── */
    @media (max-width: 900px) {
      .post-wrap { padding-top: calc(var(--header-h, 72px) + 140px); }
      .post__grid { grid-template-columns: 1fr; }
      .post__side { position: static; }
      .post__h1 { font-size: 26px; }
    }
  </style>
</BaseLayout>
