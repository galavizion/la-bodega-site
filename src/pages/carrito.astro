---
import BaseLayout from "../layouts/BaseLayout.astro";
import { client as sanityClient } from "../lib/sanity/client";
import { SITE_SETTINGS_QUERY } from "../lib/sanity/queries";

const settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);
const defaultPhone = (settings?.organization?.whatsapp ?? "528121087053").replace(/\D/g, "");
const waBase = `https://wa.me/${defaultPhone}`;
---

<BaseLayout title="Carrito | Ranking Agencia" canonical="https://www.rankingagencia.com/carrito/" bodyClass="is-shop">
  <main class="container cart-wrap">
    <header class="cart-head">
      <div>
        <h1 class="cart-title">Carrito</h1>
        <p class="cart-sub">Arma tu cotización y envíala por WhatsApp. Rápido y sin fricción.</p>
      </div>

      <div class="cart-actions">
        <a class="btn btn--ghost" href="/catalogo/">Seguir viendo</a>
        <button class="btn btn--danger" type="button" data-clear>Vaciar</button>
      </div>
    </header>

    <section class="cart-card">
      <div class="cart-list" data-cart-list>
        <!-- JS render -->
      </div>

      <footer class="cart-footer">
       <div class="cart-summary">
  <div class="sum-row">
    <span>Items</span>
    <strong data-sum-items>0</strong>
  </div>
  <div class="sum-row">
    <span>Unidades</span>
    <strong data-sum-qty>0</strong>
  </div>
  <div class="sum-row">
    <span>Total estimado</span>
    <strong data-sum-total>$0 MXN</strong>
  </div>
</div>
        <div class="cart-footer__ctas">
          <a
            class="btn btn--wa"
            data-wa
            href={`${waBase}?text=${encodeURIComponent("Hola, quiero cotizar lo siguiente:")}`}
            target="_blank"
            rel="noopener"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Cotizar por WhatsApp
          </a>
          <a class="btn btn--checkout" href="/checkout/" id="checkoutBtn">
            Proceder al pago →
          </a>
        </div>
      </footer>
    </section>

    <p class="cart-note">
      Tip: el mensaje incluye “Mis datos” para que lo llenes rápido en WhatsApp.
    </p>
  </main>

  <script is:inline>
    (() => {
      const KEY = "ranking_cart_v1";

      const listEl = document.querySelector("[data-cart-list]");
      const waBtn = document.querySelector("[data-wa]");
      const sumItems = document.querySelector("[data-sum-items]");
      const sumQty = document.querySelector("[data-sum-qty]");
const sumTotal = document.querySelector("[data-sum-total]");
      const getCart = () => {
        try { return JSON.parse(localStorage.getItem(KEY) || "[]"); }
        catch { return []; }
      };

      const emit = () => {
        const items = getCart();
        const count = items.length;
        const totalQty = items.reduce((acc, it) => acc + (it.qty || 1), 0);

        window.dispatchEvent(
          new CustomEvent("cart:updated", { detail: { count, totalQty } })
        );
      };

      const setCart = (items) => {
        localStorage.setItem(KEY, JSON.stringify(items));
        emit();
      };

      const buildWaText = (items) => {
        const lines = [];
        lines.push("Hola, quiero cotizar lo siguiente:");
        lines.push("");

        items.forEach((it, idx) => {
          const qty = it.qty || 1;
          const url = it.url || (it.slug ? `/catalogo/${it.slug}/` : "");
          const fullUrl = url
            ? (url.startsWith("http") ? url : `${location.origin}${url}`)
            : "";

          lines.push(`${idx + 1}) ${it.title || "Servicio"} x${qty}`);
          if (fullUrl) lines.push(fullUrl);
          lines.push("");
        });

        lines.push("Mis datos:");
        lines.push("Nombre:");
        lines.push("Empresa:");
        lines.push("Tel:");
        lines.push("");

        return lines.join("\n");
      };

      const render = () => {
        const items = getCart();
const total = items.reduce((acc, it) => {
  const price = Number(it.price || 0);
  const qty = it.qty || 1;
  return acc + (price * qty);
}, 0);
        // Summary
        const count = items.length;
        const totalQty = items.reduce((acc, it) => acc + (it.qty || 1), 0);
       if (sumItems) sumItems.textContent = String(count);
if (sumQty) sumQty.textContent = String(totalQty);

if (sumTotal) {
  sumTotal.textContent = total
    ? `$${total.toLocaleString("es-MX")} MXN`
    : "$0 MXN";
}

        // WhatsApp link
        const text = items.length
          ? buildWaText(items)
          : "Hola, quiero cotizar. ¿Me apoyas?\n\nMis datos:\nNombre:\nEmpresa:\nTel:\n";

        if (waBtn) {
          const base = waBtn.href.split("?")[0];
          waBtn.href = `${base}?text=${encodeURIComponent(text)}`;
          waBtn.classList.toggle("is-disabled", items.length === 0);
          waBtn.setAttribute("aria-disabled", items.length === 0 ? "true" : "false");
        }

        // Empty state
        if (!listEl) return;
        if (!items.length) {
          listEl.innerHTML = `
            <div class="empty">
              <h2>Está vacío 👀</h2>
              <p>Vete al catálogo y agrega lo que quieras cotizar.</p>
              <a class="btn btn--primary" href="/catalogo/">Ir al catálogo</a>
            </div>
          `;
          return;
        }

        // List (con imagen)
        listEl.innerHTML = items.map((it, i) => {
          const qty = it.qty || 1;
          const url = it.url || (it.slug ? `/catalogo/${it.slug}/` : "#");
          const img = it.image || it.cover || it.coverImage || "";
          const unitPrice = Number(it.price || 0);
          const subtotal = unitPrice * qty;
          const priceHtml = unitPrice
            ? `<div class="row-price">$${unitPrice.toLocaleString("es-MX")} MXN × ${qty} = <strong>$${subtotal.toLocaleString("es-MX")} MXN</strong></div>`
            : `<div class="row-price row-price--quote">Precio a cotizar</div>`;

          return `
            <article class="row-cart" data-row data-index="${i}">
              <a class="thumb" href="${url}" aria-label="Ver ${it.title || "Servicio"}">
                ${
                  img
                    ? `<img src="${img}" alt="${it.title || "Servicio"}" loading="lazy" />`
                    : `<div class="thumb__ph" aria-hidden="true"></div>`
                }
              </a>

              <div class="row-main">
                <a class="row-title" href="${url}">${it.title || "Servicio"}</a>
                ${priceHtml}
              </div>

              <div class="row-qty">
                <button class="qty-btn" type="button" data-dec aria-label="Disminuir">−</button>
                <span class="qty">${qty}</span>
                <button class="qty-btn" type="button" data-inc aria-label="Aumentar">+</button>
              </div>

              <button class="row-remove" type="button" data-remove aria-label="Quitar">Quitar</button>
            </article>
          `;
        }).join("");
      };

      // Delegated click handlers
      document.addEventListener("click", (e) => {
        const clearBtn = e.target?.closest?.("[data-clear]");
        if (clearBtn) {
          setCart([]);
          render();
          return;
        }

        const row = e.target?.closest?.("[data-row]");
        if (!row) return;

        const idx = Number(row.getAttribute("data-index"));
        if (Number.isNaN(idx)) return;

        const items = getCart();
        const item = items[idx];
        if (!item) return;

        if (e.target?.closest?.("[data-inc]")) {
          item.qty = (item.qty || 1) + 1;
          items[idx] = item;
          setCart(items);
          render();
          return;
        }

        if (e.target?.closest?.("[data-dec]")) {
          const q = item.qty || 1;
          if (q <= 1) items.splice(idx, 1);
          else {
            item.qty = q - 1;
            items[idx] = item;
          }
          setCart(items);
          render();
          return;
        }

        if (e.target?.closest?.("[data-remove]")) {
          items.splice(idx, 1);
          setCart(items);
          render();
          return;
        }

        
      });

      // init
      render();
      emit();
    })();
  </script>

 <style is:global>
    .cart-wrap{ padding: 150px 0 80px; }
    @media (max-width: 900px) { .cart-wrap { padding-top: 32px; } }

.cart-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}
.cart-title{ margin:0; font-size: 34px; letter-spacing:-.02em; }
.cart-sub{ margin:8px 0 0; opacity:.75; max-width: 70ch; }

.cart-actions{ display:flex; gap:10px; flex-wrap:wrap; }

.cart-card{
  background:#fff;
  overflow:hidden;
  box-shadow: 0 4px 24px rgba(0,0,0,.10);
  color:#111827;
}

/* lista */
.cart-list{
  padding: 18px;
  display:grid;
  gap: 12px;
}

.row-cart{
  display: grid;
  grid-template-columns: 86px 1fr auto auto;
  gap: 14px;
  align-items: center;
  padding: 14px;
  background: rgba(17,24,39,.03);
  border-bottom: 1px solid rgba(17,24,39,.08);
}

/* thumb */
.thumb{
  width: 86px;
  height: 64px;
  overflow: hidden;
  display: block;
  flex-shrink: 0;
  border: 1px solid rgba(17,24,39,.08);
  background: rgba(17,24,39,.04);
}

.thumb img{
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.thumb__ph{
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(17,24,39,.10), rgba(17,24,39,.03));
}

/* texto */
.row-main{
  min-width: 0;
}
.row-title{
  font-weight: 900;
  text-decoration:none;
  color: inherit;
  display:block;
  line-height: 1.25;
  font-size: 15px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.row-title:hover{ text-decoration: underline; }

.row-price{
  font-size: 13px;
  color: #b90404;
  font-weight: 700;
  margin-top: 5px;
}
.row-price--quote{
  color: #6b7280;
  font-weight: 500;
}

/* qty */
.row-qty{
  display:flex;
  align-items:center;
  gap: 10px;
  background: rgba(255,255,255,.92);
  border: 1px solid rgba(17,24,39,.10);
  padding: 6px 10px; width: fit-content;
}
.qty{ min-width: 18px; text-align:center; font-weight: 900; }

.qty-btn{
  width: 32px;
  height: 32px;
  border: 0;
  background: rgba(17,24,39,.08);
  cursor: pointer;
  font-size: 18px;
  line-height: 1;
}
.qty-btn:hover{ background: rgba(17,24,39,.14); }

/* quitar */
.row-remove{
  border: 1px solid rgba(255, 5, 5, 0.1);
  background: transparent;
  color: rgba(231, 0, 0, 0.65);
  font-weight: 900;
  cursor:pointer;
  white-space: nowrap;
  padding: 6px 8px;
}
.row-remove:hover{ text-decoration: underline; }

/* footer */
.cart-footer{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap: 16px;
  padding: 18px;
  border-top: 1px solid rgba(17,24,39,.08);
  background: rgba(255,255,255,.85);
  flex-wrap: wrap;
}

.cart-summary{
  display:grid;
  gap: 6px;
  min-width: 220px;
}
.sum-row{
  display:flex;
  justify-content:space-between;
  gap: 16px;
  font-size: 13px;
  opacity:.9;
}

/* buttons */
.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding: 12px 16px;
  text-decoration:none;
  font-weight: 900;
  border: 0;
  cursor: pointer;
  transition: .2s ease;
  user-select:none;
}

.cart-footer__ctas{ display:flex; flex-direction:column; gap:10px; min-width:220px; }

.btn--wa{ background:#25d366; color:#fff; display:inline-flex; align-items:center; gap:8px; }
.btn--wa:hover{ background:#128c7e; transform: translateY(-1px); }

.btn--checkout{ background:#0f8604; color:#fff; }
.btn--checkout:hover{ background:#03ac2d; transform: translateY(-1px); }

.btn--primary{ background:#0f8604; color:#fff; }
.btn--primary:hover{ background:#03ac2d; transform: translateY(-1px); }

.btn--ghost{ background: rgba(17, 24, 39, 0.753); color:#ffffff; }
.btn--ghost:hover{ background: rgba(17,24,39,.12); transform: translateY(-1px); }

.btn--danger{ background: rgba(224, 2, 2, 0.884); color:#ffffff; }
.btn--danger:hover{ background: rgba(220, 38, 38, 0.459); transform: translateY(-1px); }

.is-disabled{ opacity:.5; pointer-events:none; }

/* empty */
.empty{
  padding: 40px 18px;
  text-align:center;
}
.empty h2{ margin:0 0 8px; font-size: 20px; }
.empty p{ margin:0 0 14px; opacity:.75; }

.cart-note{
  margin-top: 14px;
  opacity:.7;
  font-size: 13px;
}

/* mobile */
@media (max-width: 820px){
  .row-cart{
    grid-template-columns: 72px 1fr;
    grid-template-areas:
      "thumb main"
      "qty qty"
      "remove remove";
    gap: 12px;
  }

  .thumb{ width:72px; height:58px; }

  .row-main{ grid-area: main; }
  .row-qty{
    grid-area: qty;
    justify-content: space-between;
    width: 100%;
  }
  .row-remove{
    grid-area: remove;
    text-align:left;
    padding-top: 8px;
  }

  .cart-footer__ctas{ width: 100%; }
  .cart-footer .btn{ width: 100%; }
  .cart-summary{ width:100%; }
}
  </style>
</BaseLayout>