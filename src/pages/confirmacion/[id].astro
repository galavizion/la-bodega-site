---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { client as sanityClient } from "../../lib/sanity/client";
import { SITE_SETTINGS_QUERY } from "../../lib/sanity/queries";
import groq from "groq";

const { id } = Astro.params;

const [order, settings] = await Promise.all([
  sanityClient.fetch(
    groq`*[_type == "order" && orderNumber == $num][0]{
      orderNumber, status, createdAt, paymentMethod, confirmationToken,
      customer{ name, email, phone, address, colonia, city, state, zip, reference },
      items[]{
        _key,
        "title": coalesce(product->title, variantLabel),
        quantity,
        unitPrice
      },
      subtotal, shipping, iva, total
    }`,
    { num: id }
  ),
  sanityClient.fetch(SITE_SETTINGS_QUERY),
]);

if (!order) {
  return Astro.redirect("/catalogo/", 302);
}

// Pedidos creados antes de este cambio no tienen token — se dejan pasar para
// no romper links viejos. Los nuevos SIEMPRE deben traer el token correcto.
const token = Astro.url.searchParams.get("t") ?? "";
if (order.confirmationToken && order.confirmationToken !== token) {
  return Astro.redirect("/catalogo/", 302);
}

if (settings?.catalogOnlyMode) return Astro.redirect("/catalogo/", 302);

const payment = settings?.payment ?? {};
const waPhone = (settings?.organization?.whatsapp ?? "528121087053").replace(/\D/g, "");
const payData = {
  bankName:      payment.bankName      ?? "",
  accountHolder: payment.accountHolder ?? "",
  clabe:         payment.clabe         ?? "",
  accountNumber: payment.accountNumber ?? "",
  reference:     payment.reference     || `Pedido ${order.orderNumber}`,
  instructions:  payment.instructions  ?? "Envíanos el comprobante por WhatsApp para confirmar tu pedido.",
  proofWhatsapp: payment.proofWhatsapp !== false,
};

const total = order.total ?? order.subtotal ?? 0;
const fmtMXN = (n: number) => `$${Number(n).toLocaleString("es-MX", { maximumFractionDigits: 2 })} MXN`;
const date  = order.createdAt
  ? new Date(order.createdAt).toLocaleDateString("es-MX", { day: "numeric", month: "long", year: "numeric" })
  : "";

const proofMsg = `Hola, te envío el comprobante de pago del pedido #${order.orderNumber} por $${Number(total).toLocaleString("es-MX", { maximumFractionDigits: 2 })} MXN.`;
const proofUrl = `https://wa.me/${waPhone}?text=${encodeURIComponent(proofMsg)}`;
---

<BaseLayout
  title={`Pedido #${order.orderNumber} confirmado | La Bodega del Instalador`}
  bodyClass="is-shop"
>
  <main class="cf-wrap container">

    <!-- ── Banner ── -->
    <div class="cf-banner">
      <div class="cf-banner__icon">✅</div>
      <div>
        <h1 class="cf-banner__title">¡Pedido recibido!</h1>
        <p class="cf-banner__sub">
          Te confirmamos el pedido <strong>#{order.orderNumber}</strong>
          {date && <> del {date}</>}.
          En breve nos ponemos en contacto contigo.
        </p>
      </div>
    </div>

    <div class="cf-grid">

      <!-- ── Resumen del pedido ── -->
      <div class="cf-left">
        <section class="cf-card">
          <h2 class="cf-card__title">Resumen del pedido</h2>
          <table class="cf-table">
            <thead>
              <tr>
                <th>Producto</th>
                <th>Cant.</th>
                <th>Subtotal</th>
              </tr>
            </thead>
            <tbody>
              {order.items?.map((it: any) => (
                <tr>
                  <td>{it.title || "Producto"}</td>
                  <td class="cf-td--center">{it.quantity ?? 1}</td>
                  <td class="cf-td--right">
                    {it.unitPrice
                      ? `$${(Number(it.unitPrice) * Number(it.quantity ?? 1)).toLocaleString("es-MX", { maximumFractionDigits: 2 })} MXN`
                      : "—"}
                  </td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              {order.shipping != null && (
                <tr>
                  <td colspan="2">Envío</td>
                  <td class="cf-td--right">{order.shipping ? fmtMXN(order.shipping) : "Gratis"}</td>
                </tr>
              )}
              {order.iva > 0 && (
                <tr>
                  <td colspan="2">IVA</td>
                  <td class="cf-td--right">{fmtMXN(order.iva)}</td>
                </tr>
              )}
              <tr>
                <td colspan="2"><strong>Total</strong></td>
                <td class="cf-td--right">
                  <strong>
                    {total ? fmtMXN(total) : "A cotizar"}
                  </strong>
                </td>
              </tr>
            </tfoot>
          </table>
        </section>

        <section class="cf-card">
          <h2 class="cf-card__title">Datos del cliente</h2>
          <dl class="cf-dl">
            <dt>Nombre</dt>   <dd>{order.customer?.name ?? "—"}</dd>
            <dt>Email</dt>    <dd>{order.customer?.email ?? "—"}</dd>
            <dt>Teléfono</dt> <dd>{order.customer?.phone ?? "—"}</dd>
            {order.customer?.address && <><dt>Dirección</dt><dd>{order.customer.address}</dd></>}
            {order.customer?.colonia && <><dt>Colonia</dt><dd>{order.customer.colonia}</dd></>}
            {order.customer?.city    && <><dt>Ciudad</dt>   <dd>{order.customer.city}{order.customer?.state ? `, ${order.customer.state}` : ""}</dd></>}
            {order.customer?.zip       && <><dt>Código postal</dt><dd>{order.customer.zip}</dd></>}
            {order.customer?.reference && <><dt>Referencia</dt><dd>{order.customer.reference}</dd></>}
          </dl>
        </section>
      </div>

      <!-- ── Instrucciones de pago ── -->
      <aside class="cf-right">
        <section class="cf-card cf-card--pay">
          <h2 class="cf-card__title">🏦 Instrucciones de pago</h2>
          <p class="cf-pay__method">Transferencia / Depósito bancario</p>

          {(payData.bankName || payData.accountHolder || payData.clabe || payData.accountNumber) && (
            <div class="cf-bank">
              {payData.bankName && (
                <div class="cf-bank__row">
                  <span class="cf-bank__label">Banco</span>
                  <span>{payData.bankName}</span>
                </div>
              )}
              {payData.accountHolder && (
                <div class="cf-bank__row">
                  <span class="cf-bank__label">Titular</span>
                  <span>{payData.accountHolder}</span>
                </div>
              )}
              {payData.clabe && (
                <div class="cf-bank__row">
                  <span class="cf-bank__label">CLABE</span>
                  <span class="cf-bank__mono">{payData.clabe}</span>
                  <button type="button" class="cf-copy" data-copy={payData.clabe}>Copiar</button>
                </div>
              )}
              {payData.accountNumber && (
                <div class="cf-bank__row">
                  <span class="cf-bank__label">No. cuenta</span>
                  <span class="cf-bank__mono">{payData.accountNumber}</span>
                  <button type="button" class="cf-copy" data-copy={payData.accountNumber}>Copiar</button>
                </div>
              )}
              <div class="cf-bank__row cf-bank__row--highlight">
                <span class="cf-bank__label">Monto</span>
                <strong>{total ? `$${Number(total).toLocaleString("es-MX", { maximumFractionDigits: 2 })} MXN` : "Ver cotización"}</strong>
              </div>
              <div class="cf-bank__row">
                <span class="cf-bank__label">Referencia</span>
                <span>{payData.reference}</span>
                <button type="button" class="cf-copy" data-copy={payData.reference}>Copiar</button>
              </div>
            </div>
          )}

          {payData.instructions && (
            <p class="cf-pay__instructions">{payData.instructions}</p>
          )}

          {payData.proofWhatsapp && (
            <a class="cf-wa-btn" href={proofUrl} target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Enviar comprobante por WhatsApp
            </a>
          )}
        </section>

        <div class="cf-actions">
          <a class="cf-btn cf-btn--outline" href="/catalogo/">Seguir comprando</a>
        </div>
      </aside>

    </div>
  </main>

  <script is:inline>
    // Llegar aquí significa que el pedido quedó confirmado (transferencia) o pagado (MercadoPago)
    localStorage.removeItem("ranking_cart_v1");
    window.dispatchEvent(new CustomEvent("cart:updated", { detail: { count: 0, totalQty: 0 } }));

    document.querySelectorAll("[data-copy]").forEach((btn) => {
      btn.addEventListener("click", () => {
        navigator.clipboard.writeText(btn.getAttribute("data-copy") || "");
        const orig = btn.textContent;
        btn.textContent = "✓ Copiado";
        setTimeout(() => (btn.textContent = orig), 2000);
      });
    });
  </script>

  <style>
    .cf-wrap {
      padding-top: calc(var(--header-h, 80px) + 40px);
      padding-bottom: 80px;
    }

    /* ── Banner ── */
    .cf-banner {
      display: flex;
      align-items: center;
      gap: 20px;
      background: #f0fdf4;
      border: 1px solid #86efac;
      padding: 24px 28px;
      margin-bottom: 36px;
    }
    .cf-banner__icon { font-size: 36px; line-height: 1; flex-shrink: 0; }
    .cf-banner__title { margin: 0 0 4px; font-size: 22px; }
    .cf-banner__sub { margin: 0; opacity: .7; font-size: 14px; line-height: 1.6; }

    /* ── Grid ── */
    .cf-grid {
      display: grid;
      grid-template-columns: 1fr 360px;
      gap: 28px;
      align-items: start;
    }

    /* ── Cards ── */
    .cf-card {
      background: #fff;
      border: 1px solid rgba(0,0,0,.1);
      padding: 24px;
      margin-bottom: 20px;
    }
    .cf-card--pay { border-color: #86efac; }
    .cf-card__title {
      font-size: 13px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .07em;
      opacity: .5;
      margin: 0 0 18px;
    }

    /* ── Tabla ── */
    .cf-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    .cf-table th {
      text-align: left;
      padding: 8px 10px;
      font-size: 11px;
      text-transform: uppercase;
      opacity: .45;
      border-bottom: 1px solid rgba(0,0,0,.08);
      font-weight: 700;
    }
    .cf-table td { padding: 10px 10px; border-bottom: 1px solid rgba(0,0,0,.06); }
    .cf-table tfoot td { border-top: 2px solid rgba(0,0,0,.1); border-bottom: none; padding-top: 12px; }
    .cf-td--center { text-align: center; }
    .cf-td--right  { text-align: right; }

    /* ── DL cliente ── */
    .cf-dl {
      display: grid;
      grid-template-columns: 90px 1fr;
      gap: 8px 14px;
      font-size: 13px;
      margin: 0;
    }
    .cf-dl dt { font-weight: 700; opacity: .55; }
    .cf-dl dd { margin: 0; }

    /* ── Pago ── */
    .cf-pay__method {
      font-weight: 700;
      font-size: 15px;
      margin: 0 0 16px;
    }
    .cf-bank {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      margin-bottom: 16px;
    }
    .cf-bank__row {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 9px 14px;
      border-bottom: 1px solid #e2e8f0;
      font-size: 13px;
    }
    .cf-bank__row:last-child { border-bottom: none; }
    .cf-bank__row--highlight { background: #f0fdf4; }
    .cf-bank__label { width: 80px; font-weight: 600; opacity: .55; flex-shrink: 0; }
    .cf-bank__mono  { font-family: monospace; font-size: 15px; letter-spacing: .08em; flex: 1; }
    .cf-copy {
      padding: 3px 8px;
      border: 1px solid rgba(0,0,0,.12);
      background: #fff;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      flex-shrink: 0;
    }
    .cf-copy:hover { background: #f0fdf4; }

    .cf-pay__instructions {
      font-size: 13px;
      line-height: 1.7;
      opacity: .7;
      margin: 0 0 20px;
    }

    /* ── WhatsApp button ── */
    .cf-wa-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 14px;
      background: #25d366;
      color: #fff;
      text-decoration: none;
      font-weight: 800;
      font-size: 14px;
      transition: background .15s;
    }
    .cf-wa-btn:hover { background: #128c7e; }

    /* ── Acciones ── */
    .cf-actions { margin-top: 4px; }
    .cf-btn {
      display: block;
      text-align: center;
      padding: 12px;
      text-decoration: none;
      font-weight: 700;
      font-size: 14px;
      transition: background .15s;
    }
    .cf-btn--outline {
      border: 1px solid rgba(0,0,0,.2);
      color: inherit;
    }
    .cf-btn--outline:hover { background: rgba(0,0,0,.04); }

    /* ── Mobile ── */
    @media (max-width: 820px) {
      .cf-grid { grid-template-columns: 1fr; }
      .cf-right { order: -1; }
    }
  </style>
</BaseLayout>
